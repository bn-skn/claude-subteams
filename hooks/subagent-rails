#!/bin/bash
# SubagentStart / SubagentStop hook.
#  - SubagentStart: static rails-pointer + honesty reminder for every subagent.
#  - SubagentStop (P3.1): review-marker write when the FINISHED subagent is a
#    code reviewer. The marker used to be written on Start, which opened the
#    commit gate the moment a reviewer was merely spawned (or failed/aborted);
#    now it needs a completed run (and a non-blank result when the CLI sends one).
# Guard polarity: this hook fires FOR subagents — it is never skipped on agent_id
# presence (that would be the INVERSE of coord-notify's guard, which skips ON
# agent_id presence because coord-notify is orchestrator-only). No opt-in env gate
# either: rails-pointer + honesty reminder are cheap and safe to always emit.
#
# The injected additionalContext is STATIC and plugin-authored only — it never
# embeds file contents (only tells the subagent WHERE to look), so it carries
# no untrusted data.
#
# P3.1 review marker: if the stopped subagent's agent_type contains
# code-reviewer (substring, case-insensitive — also catches gpt-code-reviewer,
# plugin-scoped "claude-subteams:code-reviewer" and custom teammate names that
# embed it) and last_assistant_message is not blank (absent counts as not
# blank — current CLI omits the field), write a marker file at
# ${XDG_CACHE_HOME:-$HOME/.cache}/claude-subteams/review-marks/<session_id>.
# hooks/pre-commit-gate checks for that marker before allowing a `git commit`
# that touches code files. Best-effort: requires jq and a usable session_id;
# if either is missing we simply skip marking (fail toward NOT recording a
# review, never toward a false claim that one happened).
#
# 1.50 test receipts (IMPL-PLAN testing-ui §5.3), only for the CANONICAL
# ui-tester / test-engineer (agent_type == name or ends with ":name" — never a
# substring match, so "not-ui-tester" or "ui-tester-lite" write nothing):
#   SubagentStart → t_start in .../claude-subteams/agent-starts/<agent_id> (kept
#     after Stop for resumed agents, purged after 2 days);
#   SubagentStop  → a `ui` / `te` receipt in the repo's receipt store with the
#     status (first non-empty line `Status: pass|degraded|issues-found|blocked` of
#     last_assistant_message, else of the last SubagentHandback .input.message in
#     agent_transcript_path — polled briefly, the transcript is written after the
#     hook fires — else of the last assistant text there), the content snapshot at
#     stop, t_start/t_end and an evidence summary — in every store that got the
#     agent's evidence (global recent index, B3). Unparsable status → a `rejected`
#     receipt with the reason (B6); no t_start → none. Whether a receipt COUNTS
#     (evidence during [t_start, t_end], drift) is decided at check time by tc_agent_check — the commit gate and
#     `subteams-tests status` — so a pass without evidence never shadows a valid one.
# Silent-fail: any internal error falls through to exit 0 (never break a session).

EVENT="${1:-}"
case "$EVENT" in SubagentStart|SubagentStop) ;; *) exit 0 ;; esac

INPUT=$(cat 2>/dev/null)
T_HOOK=$(date +%s)

_test_agent_kind() { # agent_type -> ui | te | "" (canonical match only)
  case "$1" in
    ui-tester|*:ui-tester) echo ui ;;
    test-engineer|*:test-engineer) echo te ;;
  esac
}

START_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claude-subteams/agent-starts"

# _status_of <text> -> the status word if the first non-empty line is the Status
# line. Tolerant (B6): leading markdown (**, __, `, #, >, "- ", "* ", spaces) is
# stripped; "Status" or "Статус" in any case; markdown between the word and the
# colon and after it is allowed; the verdict must be exactly one of
# pass|degraded|issues-found|blocked (any case), followed by the end of the line,
# whitespace or punctuation — but NOT by "|" (the copied template
# "Status: pass | degraded | …" is not a verdict).
_status_of() {
  local line rest re
  line=$(printf '%s\n' "$1" | awk 'NF { print; exit }')
  line="${line%$'\r'}"
  while :; do
    case "$line" in
      [[:space:]]*) line="${line#?}" ;;
      '**'*|'__'*|'- '*|'* '*) line="${line#??}" ;;
      '`'*|'#'*|'>'*|'*'*|'_'*) line="${line#?}" ;;
      *) break ;;
    esac
  done
  re='^(Status|STATUS|status|Статус|СТАТУС|статус)[*_`[:space:]]*:[*_`[:space:]]*([A-Za-z-]+)(.*)$'
  [[ $line =~ $re ]] || return 0
  case "$(printf '%s' "${BASH_REMATCH[2]}" | tr '[:upper:]' '[:lower:]')" in
    pass|degraded|issues-found|blocked) ;;
    *) return 0 ;;
  esac
  rest="${BASH_REMATCH[3]}"
  case "$rest" in ''|[[:space:]]*|[[:punct:]]*) ;; *) return 0 ;; esac
  case "$rest" in -*) return 0 ;; esac
  rest="${rest#"${rest%%[![:space:]*_\`]*}"}"     # skip spaces and markdown closers
  case "$rest" in '|'*) return 0 ;; esac
  printf '%s\n' "${BASH_REMATCH[2]}" | tr '[:upper:]' '[:lower:]'
}

# _reason_stated <text> -> 0 if the result says why the live review was not
# performed: a non-empty, non-heading line right after the Status line, or the
# phrase "not performed" / "не выполнен" anywhere.
_reason_stated() {
  printf '%s\n' "$1" | grep -qiE 'not performed|не выполнен' && return 0
  printf '%s\n' "$1" | awk 'NF { n++; if (n == 2) { ok = ($0 !~ /^[ \t]*#/); exit } } END { exit !ok }'
}

_transcript_result() { # <path> -> last SubagentHandback message (rc 0) or nothing (rc 1)
  local m
  [ -f "$1" ] || return 1
  m=$(grep -F 'SubagentHandback' "$1" 2>/dev/null | jq -r 'select(.type == "assistant") | .message.content[]?
        | select(.type == "tool_use" and .name == "SubagentHandback") | .input.message // empty | @json' 2>/dev/null | tail -n 1)
  [ -n "$m" ] || return 1
  printf '%s' "$m" | jq -r . 2>/dev/null
}

_transcript_last_text() { # <path> -> text of the last assistant message that has text
  [ -f "$1" ] || return 1
  tail -n 200 "$1" 2>/dev/null | jq -r 'select(.type == "assistant") | [.message.content[]? | select(.type == "text") | .text] | select(length > 0) | join("\n") | @json' 2>/dev/null \
    | tail -n 1 | jq -r . 2>/dev/null
}

# _test_receipt <ui|te> — SubagentStop for ui-tester / test-engineer.
# Order (B7): t_start, then the status (cheap: payload, then the transcript poll),
# then the stores, and only then a content snapshot per store.
# Stores (B3): the session may sit in repo A while the agent works in repo B
# (cd / git -C). Every receipt write lands in the global recent index
# (tc_recent_stores); the agent receipt is written into EACH store that got suite
# or shot evidence during [t_start, t_end], with the snapshot of the root that
# evidence came from (a worktree of that store's repository) — and into the
# payload cwd's store when no evidence was found anywhere. Max 5 stores. Every
# root read from the index is validated (directory, git work tree, same repo id);
# a store of ANOTHER repository than the session's counts only if the agent's
# transcript mentions its root (the index does not know which agent ran what).
# No parsable status -> a `rejected` receipt (no snapshot) with the reason, so the
# gate and `status` can say "ui-tester ran but its final answer had no Status line".
_test_receipt() {
  local kind="$1" aid tfile t_start t_end cwd repo rid root rr tree msg st tp rs ev rec deadline n at sid r rej=""
  local stores="" line nst=0 hd tpc=""
  aid=$(printf '%s' "$INPUT" | jq -r '.agent_id // empty' 2>/dev/null)
  printf '%s' "$aid" | grep -qE '^[A-Za-z0-9._-]+$' || return 0
  case "$aid" in .|..) return 0 ;; esac
  tfile="$START_DIR/$aid"
  [ -f "$tfile" ] || return 0
  # kept (B8): a resumed agent (SendMessage) may stop again without a new
  # SubagentStart; start files are purged by age on SubagentStart
  t_start=$(head -n 1 "$tfile" 2>/dev/null | tr -cd '0-9')
  [ -n "$t_start" ] || return 0
  t_end="$T_HOOK"
  # Status: last_assistant_message; else the transcript (SubagentHandback, polled
  # until ~2 s are used, never past ~4 s of hook time; then the last assistant text).
  msg=$(printf '%s' "$INPUT" | jq -r 'if (.last_assistant_message | type) == "string" then .last_assistant_message else empty end' 2>/dev/null)
  st=$(_status_of "$msg")
  tp=$(printf '%s' "$INPUT" | jq -r '.agent_transcript_path // empty' 2>/dev/null)
  if [ -z "$st" ]; then
    if [ -n "$tp" ]; then
      deadline=$(( T_HOOK + 4 )); n=0
      while :; do
        msg=$(_transcript_result "$tp") && st=$(_status_of "$msg")
        [ -n "$st" ] && break
        n=$((n + 1)); [ "$n" -le 10 ] && [ "$(date +%s)" -lt "$deadline" ] || break
        sleep 0.2
      done
      if [ -z "$st" ]; then msg=$(_transcript_last_text "$tp") && st=$(_status_of "$msg"); fi
    fi
  fi
  if [ -z "$st" ]; then
    if [ -z "$(printf '%s' "$msg" | tr -d '[:space:]')" ]; then rej="empty or missing final answer"
    else rej="first line: $(printf '%s\n' "$msg" | awk 'NF { print; exit }' | tr -d '\000-\037' | cut -c1-80)"; fi
  fi
  lib="$(dirname "$0")/../scripts/lib-testclass.sh"
  # shellcheck source=../scripts/lib-testclass.sh
  . "$lib" 2>/dev/null || return 0
  at=$(printf '%s' "$INPUT" | jq -r '.agent_type // empty' 2>/dev/null)
  # candidate stores: the recent index, plus the payload cwd's own store
  cwd=$(printf '%s' "$INPUT" | jq -r '.cwd // empty' 2>/dev/null)
  [ -n "$cwd" ] && [ -d "$cwd" ] || cwd="$PWD"
  repo=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) || repo=""
  stores=$(tc_recent_stores "$t_start" "$t_end")
  if [ -n "$repo" ] && rid=$(tc_repo_id "$repo"); then
    case "$stores" in *"$rid"*) ;; *) stores="$stores${stores:+$'\n'}$rid"$'\t'"$repo"$'\t'"cwd" ;; esac
  fi
  while IFS=$'\t' read -r sid r line; do
    [ -n "$sid" ] && [ -n "$r" ] && [ -d "$r" ] || continue
    root=$(git -C "$r" rev-parse --show-toplevel 2>/dev/null) || continue
    [ "$(tc_repo_id "$root" 2>/dev/null)" = "$sid" ] || continue
    # Another repository (not the session's): the index has no agent identity, so a
    # concurrent run by another session there would look like this agent's evidence.
    # Accept it only if this agent's transcript mentions that root.
    if [ "$sid" != "${rid:-}" ]; then
      [ -n "$tp" ] && [ -f "$tp" ] || continue
      grep -qF -- "$r" "$tp" 2>/dev/null || grep -qF -- "$root" "$tp" 2>/dev/null || continue
    fi
    # Evidence in this store (informational here; tc_agent_check recounts at check
    # time) and the worktree the agent actually worked in: the root of the newest
    # in-interval suite or shot receipt of this store, if it belongs to the same
    # repository — else the root from the index / the cwd.
    ev=$(tc_receipts_load "$root" | jq -sc --argjson s "$t_start" --argjson e "$t_end" '
          [.[] | select(.type == "suite" and (.t_start // 0) >= $s and (.t_end // 0) <= $e)] as $su
          | {shots: ([.[] | select(.type == "shot" and (.ts // 0) >= $s and (.ts // 0) <= $e)] | length),
             suites_ok: ([$su[] | select(.exit == 0)] | length),
             e2e_ok: ([$su[] | select(.exit == 0 and .kind == "e2e")] | length),
             root: ([($su[] | {t: (.t_end // 0), root}),
                     (.[] | select(.type == "shot" and (.ts // 0) >= $s and (.ts // 0) <= $e) | {t: (.ts // 0), root})]
                    | map(select((.root | type) == "string")) | sort_by(.t) | last | .root // null)}' 2>/dev/null)
    [ -n "$ev" ] || ev='{"shots":0,"suites_ok":0,"e2e_ok":0,"root":null}'
    # the cwd store gets the receipt only when no evidence was found anywhere
    if [ "$line" = cwd ] && [ "$nst" -gt 0 ] \
       && [ "$(printf '%s' "$ev" | jq -r '.shots + .suites_ok' 2>/dev/null)" = 0 ]; then continue; fi
    rr=$(printf '%s' "$ev" | jq -r '.root // empty' 2>/dev/null)
    if [ -n "$rr" ] && [ -d "$rr" ] && [ "$(tc_repo_id "$rr" 2>/dev/null)" = "$sid" ]; then
      root=$(git -C "$rr" rev-parse --show-toplevel 2>/dev/null) || root="$rr"
    fi
    hd=$(git -C "$root" rev-parse -q --verify 'HEAD^{commit}' 2>/dev/null) || hd=""
    if [ -n "$st" ]; then
      tree=$(tc_snapshot_tree "$root") || continue
      rs=false; [ "$st" = degraded ] && _reason_stated "$msg" && rs=true
      rec=$(jq -nc --arg type "$kind" --arg st "$st" --arg tree "$tree" --argjson s "$t_start" --argjson e "$t_end" \
            --argjson rs "$rs" --argjson ev "$ev" --arg at "$at" --arg root "$root" --arg hd "$hd" \
            '{type: $type, status: $st, tree: $tree, t_start: $s, t_end: $e, reason_stated: $rs, agent_type: $at, root: $root,
              head: $hd, evidence: ($ev | del(.root))}' 2>/dev/null) || continue
    else
      rec=$(jq -nc --arg type "$kind" --argjson s "$t_start" --argjson e "$t_end" --arg at "$at" --arg root "$root" --arg why "$rej" \
            --argjson ev "$ev" \
            '{type: $type, status: "rejected", reason: $why, t_start: $s, t_end: $e, agent_type: $at, root: $root,
              evidence: ($ev | del(.root))}' 2>/dev/null) || continue
    fi
    tc_receipt_write "$root" "$rec" >/dev/null 2>&1 && nst=$((nst + 1))
    [ "$nst" -lt 5 ] || break
  done <<< "$stores"
  return 0
}

if [ "$EVENT" = "SubagentStop" ]; then
  if command -v jq >/dev/null 2>&1; then
    SID=$(printf '%s' "$INPUT" | jq -r '.session_id // empty' 2>/dev/null)
    # agent_type: documented SubagentStart/SubagentStop field
    # (code.claude.com/docs/en/hooks; plugin-scoped form
    # "claude-subteams:code-reviewer"). .subagent_type kept as a defensive
    # fallback for older CLI payloads.
    AGENT_TYPE=$(printf '%s' "$INPUT" | jq -r '.agent_type // .subagent_type // empty' 2>/dev/null)
    # A reviewer that returned nothing (aborted, errored, killed) did not review.
    # last_assistant_message is in the SDK types but CLI 2.1.312 does NOT send it
    # (live probe 29.10.2026: SubagentStop keys = agent_id, agent_transcript_path,
    # agent_type, session_id, ... — no last_assistant_message). So: field absent
    # → trust the Stop event; field present but blank → no marker.
    RESULT=$(printf '%s' "$INPUT" | jq -r 'if (.last_assistant_message | type) == "string" then (.last_assistant_message | gsub("^\\s+|\\s+$"; "")) else "absent" end' 2>/dev/null)
    if [ -n "$SID" ] && printf '%s' "$SID" | grep -qE '^[A-Za-z0-9._-]+$' \
       && [ "$SID" != "." ] && [ "$SID" != ".." ] \
       && [ -n "$RESULT" ] \
       && printf '%s' "$AGENT_TYPE" | grep -qi 'code-reviewer'; then
      MARK_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claude-subteams/review-marks"
      mkdir -p "$MARK_DIR" 2>/dev/null
      : > "$MARK_DIR/$SID" 2>/dev/null
      find "$MARK_DIR" -type f -mtime +7 -delete 2>/dev/null
    fi
    TK=$(_test_agent_kind "$AGENT_TYPE")
    [ -n "$TK" ] && _test_receipt "$TK"
  fi
  exit 0
fi

# SubagentStart: t_start for the canonical ui-tester / test-engineer (keyed by agent_id).
if command -v jq >/dev/null 2>&1; then
  TK=$(_test_agent_kind "$(printf '%s' "$INPUT" | jq -r '.agent_type // .subagent_type // empty' 2>/dev/null)")
  if [ -n "$TK" ]; then
    AID=$(printf '%s' "$INPUT" | jq -r '.agent_id // empty' 2>/dev/null)
    if printf '%s' "$AID" | grep -qE '^[A-Za-z0-9._-]+$' && [ "$AID" != "." ] && [ "$AID" != ".." ]; then
      (umask 077; mkdir -p "$START_DIR") 2>/dev/null
      printf '%s\n' "$T_HOOK" > "$START_DIR/$AID" 2>/dev/null
      find "$START_DIR" -type f -mtime +2 -exec rm -f {} + 2>/dev/null
    fi
  fi
fi

CTX='[subteams:rails] If present in this project, read docs/CONVENTIONS.md, docs/ARCHITECTURE.md, and the active plan under docs/plans/active/ before editing, and honor the Rails field in your brief if one was given. Honesty: if a tool call fails or a fact is unverified, say so plainly; state only verified facts as fact.'

if command -v jq >/dev/null 2>&1; then
  OUT=$(jq -nc --arg e "SubagentStart" --arg c "$CTX" '{hookSpecificOutput:{hookEventName:$e, additionalContext:$c}}' 2>/dev/null)
  if [ -n "$OUT" ]; then
    printf '%s\n' "$OUT"
    exit 0
  fi
fi

printf '{"hookSpecificOutput":{"hookEventName":"SubagentStart","additionalContext":"%s"}}\n' "$CTX"
exit 0
