#!/bin/bash
# Stop hook — reminds about documentation discipline
#
# Wiring note: this fires on the Stop event, which is per-turn (end of every
# assistant turn), not end-of-session — the filename is kept for hooks.json
# wiring stability but the semantics below are per-turn.
#
# Delivery: a bare printf + exit 0 on this event is transcript-only — it
# reaches neither the model nor the operator. The verified non-blocking
# channel is a single JSON object on stdout, {"decision":"approve",
# "systemMessage":"<text>"}, then exit 0: doesn't block, and the message is
# actually seen. Stop does not support additionalContext the way
# PreToolUse/PostToolUse do, so systemMessage is the right field here. All
# reminder paths funnel through the _remind() helper below, which emits this
# JSON (jq when available, hand-escaped fallback otherwise) and exits 0.
#
# Behavior:
#   - Detects unstaged/uncommitted changes in working tree
#   - If non-doc files changed but no .md files were updated → _remind()'s a
#     reminder to update the decisions journal / descriptive docs, exit 0
#     (non-blocking — the model is never coerced)
#
# Breaking/architectural signal detection:
#   - If changed files include deletions OR schema/migration files, the hook
#     escalates to a stricter reminder in Case C (if CHANGELOG missing) and Case D.
#   - Dependency manifests, API files, and routes are NOT hook signals; they flow
#     through the normal Case C/D path. The model classifies them via doc-quality-gate.
#   - See the doc-quality-gate skill for the model-side classifier and per-class
#     doc requirements.
#   - Known limitation: filenames containing spaces are not fully parsed (uses awk
#     $NF); the hook fails toward over-reminding, never toward silence.
#
# Silent (no reminder, empty stdout) when:
#   - CLAUDE_SUBTEAMS_SKIP_DOC_CHECK=1 is set (escape hatch)
#   - No changes in working tree
#   - Only neutral / lock / config files changed, and no doc-map note pending
#   - Only docs changed, and no doc-map note pending
#   (Not in a git repo is NOT silent — it gets its own soft checklist reminder.)
#
# Escape hatch:
#   - Set CLAUDE_SUBTEAMS_SKIP_DOC_CHECK=1 to silence all reminders.
#     Use for scratch / experimental work where doc updates are deliberately deferred.
#
# Required: jq (hand-escaped fallback if missing), git.

# ---- jq detection (for JSON-safe reminder delivery) ----
HAVE_JQ=0
command -v jq &>/dev/null && HAVE_JQ=1

# Non-blocking reminder delivery (see header). Escaping mirrors hooks/autonomy-gate's
# _deny: jq handles arbitrary bytes correctly; the hand-escaped fallback additionally
# strips control chars [\001-\037] (not just backslash/quote) and turns embedded
# newlines into literal \n so a hostile file path/message can never break the JSON.
_remind() { # text -> prints {"decision":"approve","systemMessage":text} JSON, exits 0
  local msg="$1" out esc
  if [ "$HAVE_JQ" -eq 1 ]; then
    out=$(jq -nc --arg msg "$msg" '{decision:"approve",systemMessage:$msg}' 2>/dev/null)
    if [ -n "$out" ]; then
      printf '%s\n' "$out"
      exit 0
    fi
  fi
  esc=$(printf '%s' "$msg" | awk 'BEGIN{ORS="\\n"} { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/[\001-\037]/, ""); print }')
  esc="${esc%\\n}"
  printf '{"decision":"approve","systemMessage":"%s"}\n' "$esc"
  exit 0
}

# Accumulates non-terminal notes (currently: doc-map freshness) so they ride along
# with whichever terminal reminder ultimately fires, instead of being dropped.
NOTES=""

# ---- Escape hatch ----
if [ "${CLAUDE_SUBTEAMS_SKIP_DOC_CHECK:-0}" = "1" ]; then
  exit 0
fi

# ---- Drain Stop event input (hook contract expects stdin to be consumed) ----
cat >/dev/null 2>&1

# ---- Not in a git repo → soft reminder only ----
if ! git rev-parse --git-dir &>/dev/null; then
  MSG=$(
    printf '[subteams] Session ending. Quick checklist:\n'
    printf '  - BACKLOG.md updated? (completed tasks marked done)\n'
    printf '  - CHANGELOG.md updated? (if features/fixes shipped)\n'
    printf '  - SYSTEM.md / decisions journal entry added? (for non-trivial changes)\n'
    printf '  - Descriptive docs still accurate? (top of SYSTEM.md or equivalent)\n'
    printf '  - Active plan moved to completed/? (if feature finished)\n'
  )
  _remind "${NOTES}${MSG}"
fi

# ---- Get changed files in working tree (tracked + untracked) ----
# Capture full porcelain output (two passes: filenames and deletion flags)
PORCELAIN=$(git status --porcelain 2>/dev/null)

CHANGED_FILES=$(printf '%s\n' "$PORCELAIN" | awk '{ print $NF }')

# Nothing changed → silent pass
if [ -z "$CHANGED_FILES" ]; then
  exit 0
fi

# ---- Detect breaking/architectural file signals ----
# Deletions: porcelain status starts with D in col1 or col2
DELETED_FILES=$(printf '%s\n' "$PORCELAIN" | awk '{
  status = substr($0, 1, 2)
  if (index(status, "D") > 0) { print $NF }
}')

SIGNAL_FILES=""

# Helper: add a file to SIGNAL_FILES list
_add_signal() {
  local f="$1"
  SIGNAL_FILES="${SIGNAL_FILES}  - ${f}
"
}

# Check deletions
while IFS= read -r f; do
  [ -z "$f" ] && continue
  _add_signal "$f (deleted)"
done <<< "$DELETED_FILES"

# Check schema/data files among all changed files
while IFS= read -r f; do
  [ -z "$f" ] && continue
  f=${f##*-> }
  if printf '%s\n' "$f" | grep -qE '(migrations/|\.sql$|\.prisma$|schema\.)'; then
    _add_signal "$f (schema/data)"
  fi
done <<< "$CHANGED_FILES"

# Boolean: any breaking/architectural signals found?
BREAKING_SIGNALS=0
if [ -n "$SIGNAL_FILES" ]; then
  BREAKING_SIGNALS=1
fi

# Check if CHANGELOG.md is among the changed files
CHANGELOG_UPDATED=0
if printf '%s\n' "$CHANGED_FILES" | grep -qE '(^|/)CHANGELOG\.md$'; then
  CHANGELOG_UPDATED=1
fi

# ---- Doc-map freshness: a NEW spec/ADR added while the project's doc map lags ----
# Closes the gap where "code + a new spec" passed silently because any .md touch counted
# as "docs remembered" — the doc map would quietly lag the new doc.
# One all-untracked listing feeds BOTH the new-doc scan and the map-updated check, so they
# stay consistent (plain porcelain collapses a fully-untracked parent dir into "?? docs/",
# hiding the individual file).
ALL_PORCELAIN=$(git status --porcelain --untracked-files=all 2>/dev/null)

# New tracked docs = ADDED ('A'), UNTRACKED ('??'), or RENAMED-into ('R') files under
# docs/specs/ or docs/adr/. Parse the path from column 4 (after the 2-char status + space)
# so filenames with spaces are not truncated; resolve rename arrows and surrounding quotes.
# (Plans under docs/plans/ are handled by the living-plan gate, not here.)
NEW_DOC_FILES=$(printf '%s\n' "$ALL_PORCELAIN" | awk '{
  status = substr($0, 1, 2)
  path = substr($0, 4)
  sub(/^.*-> /, "", path)
  gsub(/^"|"$/, "", path)
  if (path ~ /(^|\/)docs\/(specs|adr)\/.*\.md$/ \
      && (index(status, "A") > 0 || index(status, "R") > 0 || status == "??")) print path
}')

# Locate the project's doc map: env override, else first existing candidate. If the project
# has no doc map, stay silent — never nag a project to invent one.
DOC_MAP=""
if [ -n "${CLAUDE_SUBTEAMS_DOC_MAP:-}" ] && [ -f "${CLAUDE_SUBTEAMS_DOC_MAP}" ]; then
  DOC_MAP="${CLAUDE_SUBTEAMS_DOC_MAP}"
else
  for _cand in docs/INDEX.md INDEX.md docs/SUMMARY.md mkdocs.yml; do
    if [ -f "$_cand" ]; then DOC_MAP="$_cand"; break; fi
  done
fi

# Was the doc map touched in this changeset?
DOC_MAP_UPDATED=0
if [ -n "$DOC_MAP" ] && printf '%s\n' "$ALL_PORCELAIN" | awk '{print substr($0,4)}' | grep -qFx "$DOC_MAP"; then
  DOC_MAP_UPDATED=1
fi

NEW_DOC_NO_MAP=0
if [ -n "$NEW_DOC_FILES" ] && [ -n "$DOC_MAP" ] && [ "$DOC_MAP_UPDATED" -eq 0 ]; then
  NEW_DOC_NO_MAP=1
fi

# Non-blocking note. Accumulated into NOTES (not printed directly) so it rides along
# with whichever terminal reminder fires below, regardless of how the changeset is
# otherwise classified — including the Case A/B "silent" paths, so it's never dropped.
if [ "$NEW_DOC_NO_MAP" -eq 1 ]; then
  NOTES="${NOTES}$(
    printf '[subteams] New doc(s) added under docs/specs|adr, but the doc map (%s) was not updated:\n' "$DOC_MAP"
    printf '%s\n' "$NEW_DOC_FILES" | sed 's/^/  - /'
    printf 'Add an entry to %s so the index does not lag the new doc.\n' "$DOC_MAP"
    printf '(See claude-subteams:doc-quality-gate section 2.5.)\n'
  )
"
fi

# ---- Classify files ----
# Neutral: lock files, gitignore, editor config — don't trigger doc requirement
NEUTRAL_RE='^(\.gitignore|\.editorconfig|\.gitattributes|package-lock\.json|yarn\.lock|pnpm-lock\.yaml|Cargo\.lock|go\.sum|poetry\.lock|uv\.lock|composer\.lock)$|(^|/)\.DS_Store$'

DOC_COUNT=0
CODE_COUNT=0
CODE_LIST=""

while IFS= read -r f; do
  [ -z "$f" ] && continue
  # Strip the "->" rename arrow if present (git status porcelain for renames)
  f=${f##*-> }
  # Skip neutral files
  if printf '%s\n' "$f" | grep -qE "$NEUTRAL_RE"; then
    continue
  fi
  # Classify
  if printf '%s\n' "$f" | grep -qE '\.md$'; then
    DOC_COUNT=$((DOC_COUNT + 1))
  else
    CODE_COUNT=$((CODE_COUNT + 1))
    CODE_LIST="${CODE_LIST}  - ${f}
"
  fi
done <<< "$CHANGED_FILES"

# Case A: Only neutral files or nothing left after filtering → silent, unless a
# doc-map note is pending.
if [ "$CODE_COUNT" -eq 0 ] && [ "$DOC_COUNT" -eq 0 ]; then
  if [ -n "$NOTES" ]; then
    _remind "$NOTES"
  fi
  exit 0
fi

# Case B: Only docs changed → expected state at end of work. Still remind if a new
# spec was added without a doc-map (INDEX.md) update.
if [ "$CODE_COUNT" -eq 0 ]; then
  if [ -n "$NOTES" ]; then
    _remind "$NOTES"
  fi
  exit 0
fi

# Case C: Code + docs both changed
if [ "$DOC_COUNT" -gt 0 ]; then
  # Breaking signals present AND CHANGELOG not updated → reminder, non-blocking
  if [ "$BREAKING_SIGNALS" -eq 1 ] && [ "$CHANGELOG_UPDATED" -eq 0 ]; then
    MSG=$(
      printf '[subteams:session-end-reminder] Breaking/architectural signals detected — .md files updated but CHANGELOG.md is missing.\n\n'
      printf 'Signal files (breaking/architectural):\n'
      printf '%s\n' "$SIGNAL_FILES"
      printf 'These changes need more than a generic .md touch:\n'
      printf '  1. CHANGELOG.md updated with this change.\n'
      printf '  2. Descriptive section of SYSTEM.md (or equivalent) overwritten — not appended.\n'
      printf '  3. Decision-context block (Decision / Why / Alternatives / Risks / Linked).\n'
      printf '  4. If a contract or integration broke: migration guide in the docs.\n'
      printf '  5. Consider running the doc-agent (claude-subteams:doc-agent) for a breaking-change freshness audit.\n'
      printf '     See claude-subteams:doc-quality-gate skill for the full breaking-change checklist.\n\n'
      printf 'Escape hatch: set CLAUDE_SUBTEAMS_SKIP_DOC_CHECK=1 if this reminder is wrong for this session.\n'
    )
    _remind "${NOTES}${MSG}"
  fi

  # Breaking signals present AND CHANGELOG updated → soft reminder mentioning checklist
  if [ "$BREAKING_SIGNALS" -eq 1 ] && [ "$CHANGELOG_UPDATED" -eq 1 ]; then
    MSG=$(
      printf '[subteams] Session ending. Code + docs both changed (CHANGELOG updated) — good.\n'
      printf 'Breaking/architectural signals detected:\n'
      printf '%s' "$SIGNAL_FILES"
      printf 'Reminder: verify the breaking-change checklist is complete.\n'
      printf '  - Decision-context block (Decision / Why / Alternatives / Risks / Linked)\n'
      printf '  - Descriptive section overwritten (not appended)\n'
      printf '  - Migration guide if a contract or integration broke\n'
      printf '  - Doc-agent audit recommended (claude-subteams:doc-agent)\n'
      printf '(See claude-subteams:doc-quality-gate skill for full requirements.)\n'
    )
    _remind "${NOTES}${MSG}"
  fi

  # Standard Case C: no breaking signals → soft reminder, no block
  MSG=$(
    printf '[subteams] Session ending. Code + docs both changed — good.\n'
    printf 'Reminder: ensure non-trivial decisions have a Decision context block in the journal.\n'
    printf '(See decision-context skill for format.)\n'
  )
  _remind "${NOTES}${MSG}"
fi

# Case D: Code changed WITHOUT any doc updates → reminder, non-blocking
if [ "$BREAKING_SIGNALS" -eq 1 ]; then
  # Escalated message for breaking/architectural changes
  MSG=$(
    printf '[subteams:session-end-reminder] Breaking/architectural signals detected — code changed without any documentation updates.\n\n'
    printf 'Breaking/architectural signal files:\n'
    printf '%s\n' "$SIGNAL_FILES"
    printf 'All changed code files (no .md files updated):\n'
    printf '%s\n' "$CODE_LIST"
    printf 'Before wrapping up, consider:\n'
    printf '  1. Decision-context block with Alternatives + Risks in the decisions journal\n'
    printf '     (docs/SYSTEM.md or equivalent). Format: Decision / Why / Alternatives / Risks / Linked.\n'
    printf '  2. CHANGELOG.md updated with this change.\n'
    printf '  3. Descriptive section of SYSTEM.md (or equivalent) overwritten — not appended.\n'
    printf '  4. If a contract or integration broke: migration guide in the docs.\n'
    printf '  5. Run the doc-agent (claude-subteams:doc-agent) for a breaking-change freshness audit.\n'
    printf '     See claude-subteams:doc-quality-gate skill for the full breaking-change checklist.\n\n'
    printf 'Escape hatch: set CLAUDE_SUBTEAMS_SKIP_DOC_CHECK=1 if this reminder is wrong for this session.\n'
  )
else
  # Standard Case D message
  MSG=$(
    printf '[subteams:session-end-reminder] Code changed without documentation updates.\n\n'
    printf 'Files changed (no .md files updated):\n'
    printf '%s\n' "$CODE_LIST"
    printf 'Before wrapping up, consider:\n'
    printf '  1. Add a "Decision context" block to the project decisions journal\n'
    printf '     (docs/SYSTEM.md or equivalent) for any non-trivial change.\n'
    printf '     Format: Decision / Why / Alternatives / Risks / Linked.\n'
    printf '     See the decision-context skill for full format and examples.\n'
    printf '  2. If the change affected the descriptive part of the docs (top of\n'
    printf '     SYSTEM.md or equivalent), update that section by overwriting it —\n'
    printf '     stale descriptive docs are worse than missing ones.\n'
    printf '  3. For cosmetic-only changes (whitespace, typos, patch bumps) — docs are\n'
    printf '     probably not needed for these specific files.\n\n'
    printf 'Escape hatch: set CLAUDE_SUBTEAMS_SKIP_DOC_CHECK=1 if this reminder is wrong for this session.\n'
  )
fi

_remind "${NOTES}${MSG}"
