#!/bin/bash
# Stop hook — reminds about documentation discipline
#
# Wiring note: this fires on the Stop event, which is per-turn (end of every
# assistant turn), not end-of-session — the filename is kept for hooks.json
# wiring stability but the semantics below are per-turn.
#
# Delivery: systemMessage-only, advisory-only (P8,
# docs/plans/2026-07-13-subteams-1.32-research.md). On Stop the only decision
# value that exists is "block" — we never emit a decision field, so nothing
# here ever blocks or coerces the model. Stop also supports
# hookSpecificOutput.additionalContext (text injected into the MODEL's
# context), but this hook never uses it: additionalContext on Stop risks
# either "eating" a final answer the model already wrote (the model responds
# to the hook instead of to the human) or nudging the model into unrequested
# work. Every reminder here is for the human operator to act on or ignore, so
# it goes out on the systemMessage channel only, which the model never sees:
#   {"systemMessage":"<full advisory text>"}
# then exit 0. All reminder paths funnel through the _remind() helper below,
# which emits this JSON (jq when available, hand-escaped fallback otherwise),
# writes the changeset marker (see below), and exits 0.
#
# Once per changeset: Stop fires every turn, so without a guard the same
# advisory would repeat every turn for the rest of the session. We extract
# session_id from the Stop stdin JSON and read/write a marker file at
# ${XDG_CACHE_HOME:-$HOME/.cache}/claude-subteams/session-end-marks/<session_id>.
# The marker stores the set of non-doc ("code") files that were reminded about
# the last time a reminder fired (one bare path per line; empty file for fires
# with no code list, e.g. NOTES-only or not-a-git-repo advisories). A run no
# longer exits early just because the marker exists: normal detection/
# classification always runs, and right before firing we compare the current
# code-file set against the stored one. If the current set contains at least
# one path the stored set doesn't, AND the marker is older than the cooldown
# window, the reminder fires again and the marker is overwritten with the
# current code-file set; otherwise the run stays silent. Cooldown defaults to
# 45 minutes, overridable via CLAUDE_SUBTEAMS_DOC_REMIND_COOLDOWN_MIN (positive
# integer minutes; invalid/empty falls back to the default). The marker is
# only written when a reminder actually fires — silent passes (nothing to
# report) never touch it. Markers older than 7 days are opportunistically
# pruned on runs that get past the escape hatch. If session_id cannot be
# extracted from stdin, we deliberately fall back to firing every time with no
# marker at all: availability of the reminder wins over strict gating.
#
# Behavior:
#   - Detects unstaged/uncommitted changes in working tree
#   - If non-doc files changed but no .md files were updated → _remind()'s a
#     reminder to update the decisions journal / descriptive docs, exit 0
#     (non-blocking — the model is never coerced)
#
# Breaking/architectural signal detection:
#   - If changed files include deletions OR schema/migration files, the hook
#     escalates to a stricter reminder in Case C (if CHANGELOG missing) and Case D.
#   - Dependency manifests, API files, and routes are NOT hook signals; they flow
#     through the normal Case C/D path. The model classifies them via doc-quality-gate.
#   - See the doc-quality-gate skill for the model-side classifier and per-class
#     doc requirements.
#   - Known limitation: filenames containing spaces are not fully parsed (uses awk
#     $NF); the hook fails toward over-reminding, never toward silence — except
#     the once-per-changeset marker, which intentionally silences repeats when no
#     new code files have appeared since the last fire (or the cooldown hasn't
#     elapsed yet).
#
# Silent (no reminder, empty stdout) when:
#   - CLAUDE_SUBTEAMS_SKIP_DOC_CHECK=1 is set (escape hatch)
#   - The changeset marker already covers every current code file, or the
#     cooldown window (default 45 min, CLAUDE_SUBTEAMS_DOC_REMIND_COOLDOWN_MIN)
#     since the last fire hasn't elapsed yet
#   - No changes in working tree
#   - Only neutral / lock / config files changed, and no doc-map note pending
#   - Only docs changed, and no doc-map note pending
#   (Not in a git repo is NOT silent — it gets its own soft advisory, subject to
#   the same changeset marker gating.)
#
# Escape hatch:
#   - Set CLAUDE_SUBTEAMS_SKIP_DOC_CHECK=1 to silence all reminders.
#     Use for scratch / experimental work where doc updates are deliberately deferred.
#
# Required: jq (hand-escaped fallback if missing), git. Optional: find (marker
# pruning and cooldown/freshness checks — without it markers just accumulate
# and the cooldown gate degrades to "always treat as elapsed").

# ---- jq detection (for JSON-safe reminder delivery) ----
HAVE_JQ=0
command -v jq &>/dev/null && HAVE_JQ=1

# ---- Read + drain Stop event stdin (hook contract expects stdin consumed;
# we also need session_id out of it for the changeset marker) ----
STDIN_JSON=$(cat 2>/dev/null)

# ---- Escape hatch ----
if [ "${CLAUDE_SUBTEAMS_SKIP_DOC_CHECK:-0}" = "1" ]; then
  exit 0
fi

# ---- Changeset marker setup ----
# jq preferred for session_id extraction; sed fallback matches
# "session_id"\s*:\s*"...". If both fail to find one, SESSION_ID stays empty
# and we deliberately skip the marker entirely (fire every time — see header).
SESSION_ID=""
if [ "$HAVE_JQ" -eq 1 ]; then
  SESSION_ID=$(printf '%s' "$STDIN_JSON" | jq -r '.session_id // empty' 2>/dev/null)
fi
if [ -z "$SESSION_ID" ]; then
  SESSION_ID=$(printf '%s' "$STDIN_JSON" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
fi

# Reject anything that isn't a plain token (no "/", "..", etc.) before it's used
# as a marker filename — session_id comes from stdin JSON, so treat a value
# with path-unsafe characters the same as "couldn't extract one" (fall back to
# firing with no marker, per header). "." / ".." pass the charset but resolve to
# directories, so reject them explicitly too.
if [ -n "$SESSION_ID" ]; then
  if ! printf '%s' "$SESSION_ID" | grep -qE '^[A-Za-z0-9._-]+$' \
     || [ "$SESSION_ID" = "." ] || [ "$SESSION_ID" = ".." ]; then
    SESSION_ID=""
  fi
fi

MARK_BASE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/claude-subteams/session-end-marks"
mkdir -p "$MARK_BASE_DIR" 2>/dev/null

MARKER_FILE=""
if [ -n "$SESSION_ID" ]; then
  MARKER_FILE="$MARK_BASE_DIR/$SESSION_ID"
fi

# Re-fire cooldown (minutes): how long a changeset marker must age before new
# code files are allowed to trigger another reminder (see header). Invalid or
# empty override falls back to the default.
COOLDOWN="${CLAUDE_SUBTEAMS_DOC_REMIND_COOLDOWN_MIN:-45}"
if ! printf '%s' "$COOLDOWN" | grep -qE '^[1-9][0-9]*$'; then
  COOLDOWN=45
fi

# Opportunistic prune of stale markers (errors ignored — best effort only).
find "$MARK_BASE_DIR" -type f -mtime +7 -delete 2>/dev/null
find "${XDG_CACHE_HOME:-$HOME/.cache}/claude-subteams/session-edits" -type f -mtime +7 -delete 2>/dev/null

# Short, fixed operator-facing header line prepended to every fire, ahead of
# the case-specific advisory body (see _remind).
USER_LINE="[subteams] Doc-discipline advisory (re-fires only for new undocumented files after a cooldown). Silence: CLAUDE_SUBTEAMS_SKIP_DOC_CHECK=1"

# True (0) if MARKER_FILE is younger than COOLDOWN minutes — i.e. the re-fire
# cooldown has NOT elapsed yet, so the caller must stay silent regardless of
# whether new code files showed up. Missing `find` degrades this to "always
# treat as elapsed" (see header), which is the fail-toward-reminding direction.
_marker_fresh() {
  [ -n "$(find "$MARKER_FILE" -mmin -"$COOLDOWN" 2>/dev/null)" ]
}

# True (0) if $2 (current bare code-file list, one path per line) contains at
# least one path not present in $1 (stored marker file, same format). Guards
# the two empty-input edge cases explicitly instead of relying on grep -f
# behavior on an empty pattern file: no current files -> trivially no new
# files; empty/missing stored file with non-empty current -> everything
# current is new.
_has_new_file() {
  local stored_file="$1" current="$2"
  printf '%s\n' "$current" | grep -q . || return 1
  [ -s "$stored_file" ] || return 0
  printf '%s\n' "$current" | grep -vxFf "$stored_file" | grep -q .
}

# Non-blocking reminder delivery (see header). systemMessage-only: no
# additionalContext, ever (P8). Escaping mirrors hooks/autonomy-gate's _deny:
# jq handles arbitrary bytes correctly; the hand-escaped fallback additionally
# strips control chars [\001-\037] (not just backslash/quote) and turns embedded
# newlines into literal \n so a hostile file path/message can never break the JSON.
_remind() { # advisory user_line code_bare -> prints systemMessage-only JSON, writes marker, exits 0
  local advisory="$1" userline="$2" code_bare="${3:-}" full out esc_full

  # Once-per-changeset gate (see header): only applies when a marker file
  # already exists for this session. First-ever fire in a session, and the
  # no-session_id fallback, always proceed to fire below.
  if [ -n "$MARKER_FILE" ] && [ -f "$MARKER_FILE" ]; then
    if _marker_fresh; then
      exit 0
    fi
    if ! _has_new_file "$MARKER_FILE" "$code_bare"; then
      exit 0
    fi
  fi

  full="${userline}

${advisory}"

  if [ "$HAVE_JQ" -eq 1 ]; then
    out=$(jq -nc --arg msg "$full" '{systemMessage:$msg}' 2>/dev/null)
    if [ -n "$out" ]; then
      printf '%s\n' "$out"
      _mark_session "$code_bare"
      exit 0
    fi
  fi
  esc_full=$(printf '%s' "$full" | awk 'BEGIN{ORS="\\n"} { gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/[\001-\037]/, ""); print }')
  esc_full="${esc_full%\\n}"
  printf '{"systemMessage":"%s"}\n' "$esc_full"
  _mark_session "$code_bare"
  exit 0
}

# Writes the changeset marker (bare code-file list, one per line — or an
# empty file for fires with no code list), if a session_id was available.
_mark_session() {
  local code_bare="${1:-}"
  if [ -n "$MARKER_FILE" ]; then
    # tmp+mv so a crash mid-write can't leave a truncated stored set (a partial
    # list would only over-remind, but atomic is cheap).
    if printf '%s' "$code_bare" > "$MARKER_FILE.tmp.$$" 2>/dev/null; then
      mv -f "$MARKER_FILE.tmp.$$" "$MARKER_FILE" 2>/dev/null
    else
      rm -f "$MARKER_FILE.tmp.$$" 2>/dev/null
    fi
  fi
}

# Accumulates non-terminal notes (currently: doc-map freshness) so they ride along
# with whichever terminal reminder ultimately fires, instead of being dropped.
NOTES=""

# ---- Not in a git repo → soft advisory only ----
if ! git rev-parse --git-dir &>/dev/null; then
  MSG="[subteams] Session ended outside a git repo — no change detection ran. If docs were touched, the usual places are BACKLOG / CHANGELOG / SYSTEM (decisions journal) and the active plan. If an update is warranted, ask the agent for it."
  _remind "${NOTES}${MSG}" "$USER_LINE" ""
fi

# ---- Get changed files in working tree (tracked + untracked) ----
# Capture full porcelain output (two passes: filenames and deletion flags)
PORCELAIN=$(git status --porcelain 2>/dev/null)

CHANGED_FILES=$(printf '%s\n' "$PORCELAIN" | awk '{ print $NF }')

# Nothing changed → silent pass
if [ -z "$CHANGED_FILES" ]; then
  exit 0
fi

# ---- P1 per-instance scoping ----
# hooks/post-edit-check writes every Edit/Write'd file (relpath) into a
# per-session registry. If that registry exists and is non-empty, restrict
# PORCELAIN/CHANGED_FILES to the intersection with git status — this session's
# actual edits — so a reminder never blames another instance's files. Matching
# is by porcelain's last field ($NF), the same simplistic parsing CHANGED_FILES
# already used above (renames covered the same way, nothing new there). This
# narrows the whole downstream classification (Case A-D, signal detection);
# the separate doc-map freshness check further below intentionally keeps using
# the unfiltered ALL_PORCELAIN — "did a new spec/ADR appear" isn't an
# instance-scoped question the way "did I write undocumented code" is.
# Bash-driven edits (git mv, sed, etc.) never reach post-edit-check and so
# never land in the registry — accepted degradation (documented there too).
# If the registry is empty/missing:
#   - under multi-instance (CLAUDE_SUBTEAMS_MULTI_INSTANCE=1), stay silent —
#     we can't tell whose changes these are, and silence beats blaming the
#     wrong instance;
#   - otherwise, fall through unfiltered (pre-P1 behavior).
if [ -n "$SESSION_ID" ]; then
  EDITS_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/claude-subteams/session-edits/$SESSION_ID"
  if [ -s "$EDITS_FILE" ]; then
    PORCELAIN=$(awk -v edits="$EDITS_FILE" '
      BEGIN { while ((getline line < edits) > 0) if (line != "") seen[line] = 1 }
      { f = $NF; if (f in seen) print }
    ' <<< "$PORCELAIN")
    CHANGED_FILES=$(printf '%s\n' "$PORCELAIN" | awk '{ print $NF }')
    if [ -z "$CHANGED_FILES" ]; then
      exit 0
    fi
  elif [ "${CLAUDE_SUBTEAMS_MULTI_INSTANCE:-0}" = "1" ]; then
    exit 0
  fi
fi

# ---- Detect breaking/architectural file signals ----
# Deletions: porcelain status starts with D in col1 or col2
DELETED_FILES=$(printf '%s\n' "$PORCELAIN" | awk '{
  status = substr($0, 1, 2)
  if (index(status, "D") > 0) { print $NF }
}')

SIGNAL_FILES=""

# Helper: add a file to SIGNAL_FILES list
_add_signal() {
  local f="$1"
  SIGNAL_FILES="${SIGNAL_FILES}  - ${f}
"
}

# Check deletions
while IFS= read -r f; do
  [ -z "$f" ] && continue
  _add_signal "$f (deleted)"
done <<< "$DELETED_FILES"

# Check schema/data files among all changed files
while IFS= read -r f; do
  [ -z "$f" ] && continue
  f=${f##*-> }
  if printf '%s\n' "$f" | grep -qE '(migrations/|\.sql$|\.prisma$|schema\.)'; then
    _add_signal "$f (schema/data)"
  fi
done <<< "$CHANGED_FILES"

# Boolean: any breaking/architectural signals found?
BREAKING_SIGNALS=0
if [ -n "$SIGNAL_FILES" ]; then
  BREAKING_SIGNALS=1
fi

# Check if CHANGELOG.md is among the changed files
CHANGELOG_UPDATED=0
if printf '%s\n' "$CHANGED_FILES" | grep -qE '(^|/)CHANGELOG\.md$'; then
  CHANGELOG_UPDATED=1
fi

# ---- Doc-map freshness: a NEW spec/ADR added while the project's doc map lags ----
# Closes the gap where "code + a new spec" passed silently because any .md touch counted
# as "docs remembered" — the doc map would quietly lag the new doc.
# One all-untracked listing feeds BOTH the new-doc scan and the map-updated check, so they
# stay consistent (plain porcelain collapses a fully-untracked parent dir into "?? docs/",
# hiding the individual file).
ALL_PORCELAIN=$(git status --porcelain --untracked-files=all 2>/dev/null)

# New tracked docs = ADDED ('A'), UNTRACKED ('??'), or RENAMED-into ('R') files under
# docs/specs/ or docs/adr/. Parse the path from column 4 (after the 2-char status + space)
# so filenames with spaces are not truncated; resolve rename arrows and surrounding quotes.
# (Plans under docs/plans/ are handled by the living-plan gate, not here.)
NEW_DOC_FILES=$(printf '%s\n' "$ALL_PORCELAIN" | awk '{
  status = substr($0, 1, 2)
  path = substr($0, 4)
  sub(/^.*-> /, "", path)
  gsub(/^"|"$/, "", path)
  if (path ~ /(^|\/)docs\/(specs|adr)\/.*\.md$/ \
      && (index(status, "A") > 0 || index(status, "R") > 0 || status == "??")) print path
}')

# Locate the project's doc map: env override, else first existing candidate. If the project
# has no doc map, stay silent — never nag a project to invent one.
DOC_MAP=""
if [ -n "${CLAUDE_SUBTEAMS_DOC_MAP:-}" ] && [ -f "${CLAUDE_SUBTEAMS_DOC_MAP}" ]; then
  DOC_MAP="${CLAUDE_SUBTEAMS_DOC_MAP}"
else
  for _cand in docs/INDEX.md INDEX.md docs/SUMMARY.md mkdocs.yml; do
    if [ -f "$_cand" ]; then DOC_MAP="$_cand"; break; fi
  done
fi

# Was the doc map touched in this changeset?
DOC_MAP_UPDATED=0
if [ -n "$DOC_MAP" ] && printf '%s\n' "$ALL_PORCELAIN" | awk '{print substr($0,4)}' | grep -qFx "$DOC_MAP"; then
  DOC_MAP_UPDATED=1
fi

NEW_DOC_NO_MAP=0
if [ -n "$NEW_DOC_FILES" ] && [ -n "$DOC_MAP" ] && [ "$DOC_MAP_UPDATED" -eq 0 ]; then
  NEW_DOC_NO_MAP=1
fi

# Non-blocking note. Accumulated into NOTES (not printed directly) so it rides along
# with whichever terminal reminder fires below, regardless of how the changeset is
# otherwise classified — including the Case A/B "silent" paths, so it's never dropped.
if [ "$NEW_DOC_NO_MAP" -eq 1 ]; then
  NOTES="${NOTES}$(
    printf "[subteams] New doc(s) under docs/specs|adr, but the doc map (%s) wasn't updated this session:\n" "$DOC_MAP"
    printf '%s\n' "$NEW_DOC_FILES" | sed 's/^/  - /'
    printf "The index may lag the new file(s) — ask the agent to update the map if you want it current. Reference: claude-subteams:doc-quality-gate §2.5.\n"
  )
"
fi

# ---- Classify files ----
# Neutral: lock files, gitignore, editor config — don't trigger doc requirement
NEUTRAL_RE='^(\.gitignore|\.editorconfig|\.gitattributes|package-lock\.json|yarn\.lock|pnpm-lock\.yaml|Cargo\.lock|go\.sum|poetry\.lock|uv\.lock|composer\.lock)$|(^|/)\.DS_Store$'

DOC_COUNT=0
CODE_COUNT=0
CODE_LIST=""
CODE_LIST_BARE=""

while IFS= read -r f; do
  [ -z "$f" ] && continue
  # Strip the "->" rename arrow if present (git status porcelain for renames)
  f=${f##*-> }
  # Skip neutral files
  if printf '%s\n' "$f" | grep -qE "$NEUTRAL_RE"; then
    continue
  fi
  # Classify
  if printf '%s\n' "$f" | grep -qE '\.md$'; then
    DOC_COUNT=$((DOC_COUNT + 1))
  else
    CODE_COUNT=$((CODE_COUNT + 1))
    CODE_LIST="${CODE_LIST}  - ${f}
"
    CODE_LIST_BARE="${CODE_LIST_BARE}${f}
"
  fi
done <<< "$CHANGED_FILES"

# Case A: Only neutral files or nothing left after filtering → silent, unless a
# doc-map note is pending.
if [ "$CODE_COUNT" -eq 0 ] && [ "$DOC_COUNT" -eq 0 ]; then
  if [ -n "$NOTES" ]; then
    _remind "$NOTES" "$USER_LINE" "$CODE_LIST_BARE"
  fi
  exit 0
fi

# Case B: Only docs changed → expected state at end of work. Still remind if a new
# spec was added without a doc-map (INDEX.md) update.
if [ "$CODE_COUNT" -eq 0 ]; then
  if [ -n "$NOTES" ]; then
    _remind "$NOTES" "$USER_LINE" "$CODE_LIST_BARE"
  fi
  exit 0
fi

# Case C: Code + docs both changed
if [ "$DOC_COUNT" -gt 0 ]; then
  # Breaking signals present AND CHANGELOG not updated → advisory, non-blocking
  if [ "$BREAKING_SIGNALS" -eq 1 ] && [ "$CHANGELOG_UPDATED" -eq 0 ]; then
    MSG=$(
      printf "[subteams] Breaking/architectural signals detected; .md files were updated but CHANGELOG.md wasn't:\n"
      printf '%s' "$SIGNAL_FILES"
      printf "A generic .md touch may not cover this — the breaking-change checklist (decision-context block, overwritten descriptive section, migration guide if a contract broke) lives in claude-subteams:doc-quality-gate. Ask the agent to run it if you want this covered."
    )
    _remind "${NOTES}${MSG}" "$USER_LINE" "$CODE_LIST_BARE"
  fi

  # Breaking signals present AND CHANGELOG updated → soft advisory mentioning checklist
  if [ "$BREAKING_SIGNALS" -eq 1 ] && [ "$CHANGELOG_UPDATED" -eq 1 ]; then
    MSG=$(
      printf "[subteams] Code + docs changed, CHANGELOG updated — good. Breaking/architectural signals were seen:\n"
      printf '%s' "$SIGNAL_FILES"
      printf "To double-check completeness, the breaking-change checklist is in claude-subteams:doc-quality-gate — ask the agent for it if needed. No action required."
    )
    _remind "${NOTES}${MSG}" "$USER_LINE" "$CODE_LIST_BARE"
  fi

  # Standard Case C: no breaking signals → soft advisory, no block
  MSG="[subteams] Code + docs both changed — expected end state. If any non-trivial decision lacks a Decision-context block (format: claude-subteams:decision-context), ask the agent to add one."
  _remind "${NOTES}${MSG}" "$USER_LINE" "$CODE_LIST_BARE"
fi

# Case D: Code changed WITHOUT any doc updates → advisory, non-blocking
if [ "$BREAKING_SIGNALS" -eq 1 ]; then
  # Escalated message for breaking/architectural changes
  MSG=$(
    printf "[subteams] Breaking/architectural signals detected and code changed with no .md updates.\n"
    printf 'Signal files:\n'
    printf '%s' "$SIGNAL_FILES"
    printf 'All changed code (no docs):\n'
    printf '%s' "$CODE_LIST"
    printf "The full breaking-change checklist (decision-context block, CHANGELOG, overwritten descriptive section, migration guide) is in claude-subteams:doc-quality-gate — ask the agent to run it when this piece of work wraps up."
  )
else
  # Standard Case D message
  MSG=$(
    printf "[subteams] Code changed, no .md updates.\n"
    printf 'Changed files:\n'
    printf '%s' "$CODE_LIST"
    printf "If any of these are non-trivial, consider asking the agent for a Decision-context block (format: claude-subteams:decision-context) and a descriptive-section update; cosmetic-only changes (whitespace, typos, patch bumps) don't need docs."
  )
fi

_remind "${NOTES}${MSG}" "$USER_LINE" "$CODE_LIST_BARE"
