#!/bin/bash
# Stop hook — multi-instance deregistration (opt-in).
# A SEPARATE Stop entry from session-end-reminder so it runs independently and is not
# skipped when the doc-enforcement hook exit 2's. Best-effort clean-exit cleanup;
# crash/OOM cleanup is handled by PID-based reap in coord.sh (a dead PID is reaped by
# the next peer's roster/claim/reap call regardless of whether this ran).
[ "${CLAUDE_SUBTEAMS_MULTI_INSTANCE:-0}" = "1" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

COORD="${CLAUDE_PLUGIN_ROOT}/scripts/coord.sh"
[ -x "$COORD" ] || exit 0

INPUT=$(cat 2>/dev/null || printf '{}')
SID=$(printf '%s' "$INPUT" | jq -r '.session_id // empty' 2>/dev/null)
[ -n "$SID" ] || exit 0
ID="${SID:0:8}"

"$COORD" release --id "$ID" --all >/dev/null 2>&1
"$COORD" deregister --id "$ID" >/dev/null 2>&1
exit 0
