#!/bin/bash
# SessionStart hook — minimal, no prompt injection
# Only checks for stale state from previous session.
# Methodology activation is controlled by CLAUDE.md, not by this hook.

# Check for stale state from previous session
if [ -f "BACKLOG.md" ]; then
  IN_PROGRESS=$(grep -c "^\- \[ \].*In Progress\|^## In Progress" BACKLOG.md 2>/dev/null || true)
  if [ "$IN_PROGRESS" -gt 0 ]; then
    echo "[subteams] BACKLOG.md has in-progress items — may be stale from a previous session."
  fi
fi

if [ -d "docs/plans/active" ]; then
  ACTIVE_PLANS=$(find docs/plans/active -name "*.md" 2>/dev/null | wc -l)
  if [ "$ACTIVE_PLANS" -gt 0 ]; then
    echo "[subteams] $ACTIVE_PLANS active plan(s) in docs/plans/active/."
  fi
fi
