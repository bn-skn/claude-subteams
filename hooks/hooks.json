{
  "hooks": {
    "SessionStart": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-start",
        "async": false,
        "timeout": 10
      }]
    }],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-commit-gate",
          "async": false,
          "timeout": 60
        }]
      },
      {
        "matcher": "Bash",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-push-check",
          "async": false,
          "timeout": 5
        }]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/autonomy-gate PreToolUse",
          "async": false,
          "timeout": 15
        }]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/convention-preflight",
          "async": false,
          "timeout": 5
        }]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subagent-rails SubagentStart",
          "async": false,
          "timeout": 5
        }]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/subagent-rails SubagentStop",
          "async": false,
          "timeout": 5
        }]
      }
    ],
    "PostToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/post-edit-check",
        "async": true,
        "timeout": 5
      }]
    }, {
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/coord-notify PostToolUse",
        "async": false,
        "timeout": 5
      }]
    }],
    "Stop": [
      {
        "matcher": "",
        "hooks": [{
          "type": "command",
          "command": "${CLAUDE_PLUGIN_ROOT}/hooks/session-end-reminder",
          "async": false,
          "timeout": 10
        }]
      }
    ],
    "SessionEnd": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/coord-session-end",
        "async": false,
        "timeout": 5
      }]
    }],
    "UserPromptSubmit": [{
      "matcher": "",
      "hooks": [{
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/user-prompt-check",
        "async": false,
        "timeout": 5
      }, {
        "type": "command",
        "command": "${CLAUDE_PLUGIN_ROOT}/hooks/coord-notify UserPromptSubmit",
        "async": false,
        "timeout": 5
      }]
    }]
  }
}
