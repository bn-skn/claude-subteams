#!/bin/bash
# PreToolUse hook — autonomy scope/cap enforcement gate (Tier 2 bounded autonomy).
# Fires before Edit/Write/MultiEdit/NotebookEdit/Bash. Inert (2-line exit) when
# CLAUDE_SUBTEAMS_AUTONOMY is unset — manual mode is completely unaffected; the env
# check is the FIRST thing this hook does after the event check, before touching
# stdin/disk. Delegates the actual scope/cap arithmetic to scripts/autonomy-check.sh
# (read-only invocation, no --checkpoint) so there is exactly one source of truth
# for the caps math.
#
# NEVER invoke `claude` or anything that itself triggers PreToolUse from this hook —
# that would deadlock the tool-call pipeline (plan R5).
#
# Event resolution (B1, belt-and-suspenders against wiring drift): hooks.json passes
# "PreToolUse" as $1 (mirroring coord-notify). If $1 is ever empty — e.g. the wiring
# regresses again — fall back to reading hook_event_name from stdin JSON before
# deciding whether to proceed. Either way, only PreToolUse continues past this point.
#
# Record-edit deny (B3, closes the scope-widening jailbreak): the run record itself
# — the file the agent could edit to grant itself a wider scope or looser caps mid-
# run — is denied as an edit target outright while a run is active. The script's own
# --checkpoint writes via mktemp+mv (not a tool call), so checkpoints are unaffected.
#
# Pre-hoc scope (B4, "blocks before it lands"): for the file-writing tools
# (Edit/Write/MultiEdit/NotebookEdit), when a target path is present — file_path,
# or notebook_path for NotebookEdit (G3) — it is folded into the changed-file set
# via `autonomy-check.sh --pending=<path>` BEFORE the edit executes — an
# out-of-scope target is denied before it ever touches disk. Bash has no single
# reliable target field to pre-check, so Bash stays POST-HOC for arbitrary side
# effects: a violation is caught on the NEXT gate call (diff vs base already shows
# it), not before the command runs. This is a documented, honest limitation — do
# not read this hook as pre-hoc-blocking arbitrary Bash side effects. (G4 below
# adds a narrow, BEST-EFFORT pre-hoc pattern-match specifically for Bash commands
# that reference the run record by name — it raises the bar, it does not close
# the general Bash vector.)
#
# Path canonicalization (G1, closes relative/../symlink-alias bypasses): both the
# incoming target path and each candidate record path are resolved with `_canon_path`
# (realpath -m, GNU; readlink -f fallback; raw-string degrade if neither binary
# exists — see `_canon_path` below) before the record-edit-deny comparison, so a
# relative path, a `../` round-trip, or a symlink alias cannot dodge the deny.
#
# NotebookEdit coverage (G3): NotebookEdit carries its target in tool_input.notebook_path,
# not file_path. Both are read; whichever is non-empty is used as the effective
# target for the record-edit deny AND the pre-hoc scope check.
#
# Bash record-reference deny (G4/AC9, BEST-EFFORT — raises the bar, does not close
# the vector): when tool_name is Bash and the command text references the active
# record (its basename or the literal "autonomy-run" marker), the command is DENIED
# outright — no read/write classification. A classifier that tried to allow reads
# was found (cross-model Codex review) to be trivially bypassable via command-
# chaining (`cat /dev/null; mv payload <record>` — the leading `cat` latches
# read-only, the second command writes) and strictly worse than a blanket deny, so
# the blanket deny stands. To READ the record mid-run, use the Read tool, not Bash.
# This still CANNOT catch a write that never names the record (variable/base64/heredoc
# indirection) — that residual is the documented, deferred operator decision, not
# solved here. It is partial mitigation against casual/named record edits, not a
# sandbox against a determined agent (see ADR-007).
#
# Silent-fail: any internal error here falls through to exit 0 (never break a
# session) — nothing sensitive is logged, stdout only carries the deny JSON. The
# `_raw_get` no-jq fallback does not JSON-unescape its matches (same simplification
# as before) and simply degrades to post-hoc-only enforcement if that ever matters —
# safe, since post-hoc catches it on the next call. A double failure ($1 empty AND
# stdin lacking a recognizable event) also falls through to exit 0 — deliberately
# fails OPEN here, per the never-break-a-session doctrine (manual mode is always
# safe; autonomy mode without a working gate is a degraded-but-not-silent state
# since autonomy-check.sh itself still runs on the next successful gate call).

EVENT="${1:-}"
if [ -n "$EVENT" ] && [ "$EVENT" != "PreToolUse" ]; then
  exit 0
fi

# Env gate, before any stdin/disk work. Manual mode (or a correctly-wired call with
# the env unset) pays only the lines above and this one.
[ -n "${CLAUDE_SUBTEAMS_AUTONOMY:-}" ] || exit 0

HOOK_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)" || exit 0
CHECK_SCRIPT="${HOOK_DIR}/../scripts/autonomy-check.sh"
[ -x "$CHECK_SCRIPT" ] || exit 0

# G2: resolve to the repo TOP-LEVEL before scanning for the record (mirrors
# autonomy-check.sh's own C9 resolution) — a cwd inside a subdirectory must not
# make the record scan silently miss docs/plans/active at the real repo root.
# Not a git repo (or git unusable) -> fall back to $PWD unchanged: no repo root
# means no docs/plans/active resolvable from it either, so this stays a no-op
# (allow) exactly like the pre-G2 behavior for non-git cwds.
PROJECT_DIR="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null)"
[ -n "$PROJECT_DIR" ] || PROJECT_DIR="$PWD"

# Read stdin ONCE, tty-guarded so a manual CLI invocation never hangs on a missing
# pipe. Feeds: the B1 event fallback, session id (anti-replay), tool_name and
# tool_input.file_path (B2/B3/B4).
INPUT='{}'
if [ ! -t 0 ]; then
  INPUT=$(cat 2>/dev/null || printf '{}')
fi
HAVE_JQ=0
command -v jq >/dev/null 2>&1 && HAVE_JQ=1

_jq_get() { # jq filter (already anchored with a leading '.') -> value or empty
  [ "$HAVE_JQ" -eq 1 ] || return 1
  printf '%s' "$INPUT" | jq -r "$1 // empty" 2>/dev/null
}
# Literal-key text scan (no real JSON parsing — same simplification as the prior
# session_id fallback). Works for a key at any nesting depth since it just looks
# for the first `"key": "value"` occurrence in the raw payload text.
_raw_get() { # key name (unquoted) -> value or empty
  printf '%s' "$INPUT" | awk -v k="\"$1\"" '
    {
      idx = index($0, k)
      if (idx > 0) {
        rest = substr($0, idx + length(k))
        sub(/^[[:space:]]*:[[:space:]]*/, "", rest)
        if (substr(rest, 1, 1) == "\"") {
          rest = substr(rest, 2)
          q = index(rest, "\"")
          if (q > 0) { print substr(rest, 1, q - 1); exit }
        }
      }
    }'
}

# G1: canonicalize a path — realpath -m (GNU, tolerates missing components,
# resolves symlinks and `../`) preferred; readlink -f fallback if realpath is
# absent; if neither binary exists, OR the resolution call itself fails/produces
# no output, degrade to the raw string as-is. That degrade branch is a documented,
# best-effort-only weakening (a relative/../symlink bypass could in theory survive
# on a system missing both binaries) — acceptable per the stated deps rule
# (git/grep/awk + optional jq); realpath/readlink are both standard GNU coreutils
# and expected present on any Linux target this hook runs on.
_canon_path() { # path -> canonicalized path, or the raw string if resolution fails
  local p="$1" out=""
  [ -n "$p" ] || { printf '%s' ''; return; }
  if command -v realpath >/dev/null 2>&1; then
    out=$(realpath -m -- "$p" 2>/dev/null)
  elif command -v readlink >/dev/null 2>&1; then
    out=$(readlink -f -- "$p" 2>/dev/null)
  fi
  printf '%s' "${out:-$p}"
}

if [ -z "$EVENT" ]; then
  if [ "$HAVE_JQ" -eq 1 ]; then
    EVENT=$(_jq_get '.hook_event_name')
  else
    EVENT=$(_raw_get hook_event_name)
  fi
  [ "$EVENT" = "PreToolUse" ] || exit 0
fi

if [ "$HAVE_JQ" -eq 1 ]; then
  SESSION_ID=$(_jq_get '.session_id')
  TOOL_NAME=$(_jq_get '.tool_name')
  FILE_PATH=$(_jq_get '.tool_input.file_path')
  NOTEBOOK_PATH=$(_jq_get '.tool_input.notebook_path')
  CMD_TEXT=$(_jq_get '.tool_input.command')
else
  SESSION_ID=$(_raw_get session_id)
  TOOL_NAME=$(_raw_get tool_name)
  FILE_PATH=$(_raw_get file_path)
  NOTEBOOK_PATH=$(_raw_get notebook_path)
  CMD_TEXT=$(_raw_get command)
fi

# G3: NotebookEdit carries its target in notebook_path, not file_path — whichever
# is non-empty becomes the effective target for both the record-edit deny and the
# pre-hoc scope check below.
TARGET_PATH="$FILE_PATH"
[ -n "$TARGET_PATH" ] || TARGET_PATH="$NOTEBOOK_PATH"

# G1: canonicalize the effective target ONCE, up front — every comparison below
# uses this resolved form, never the raw TARGET_PATH.
TARGET_CANON=""
[ -n "$TARGET_PATH" ] && TARGET_CANON=$(_canon_path "$TARGET_PATH")

# AC10: mirror autonomy-check.sh's C11 DoS guard — this pre-scan `grep`s every
# active IMPL-PLAN on EVERY matching PreToolUse, so a huge plan file would make an
# otherwise-cheap hook expensive per tool call. Size-check with `wc -c` (a stat,
# not a full read) and skip the grep on anything bigger. Same constant/value as
# autonomy-check.sh for consistency.
MAX_RECORD_BYTES=1048576   # 1 MB

# Quick pre-check: no active run record at all -> autonomy not in progress, allow.
# Same pass also detects (B3) whether TARGET_PATH IS one of those record files
# (G1: compared canonicalized-vs-canonicalized), and collects each record's
# basename (G4: used by the Bash pattern-match below).
ACTIVE_DIR="${PROJECT_DIR}/docs/plans/active"
HAS_RECORD=0
RECORD_HIT=0
OVERSIZED_SEEN=0
RECORD_BASENAMES=()
if [ -d "$ACTIVE_DIR" ]; then
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    # AC10: skip the grep on an oversized candidate. It cannot be confirmed as a
    # record here, so record OVERSIZED_SEEN and let autonomy-check.sh (which has
    # the same guard and fails closed on an oversized-only set) be the authority —
    # never take the fast "no record -> allow" shortcut past an unscanned file.
    FSIZE=$(wc -c < "$f" 2>/dev/null || echo 0)
    if [ "$FSIZE" -gt "$MAX_RECORD_BYTES" ]; then
      OVERSIZED_SEEN=1
      continue
    fi
    if grep -qF -- '<!-- autonomy-run:begin -->' "$f" 2>/dev/null; then
      HAS_RECORD=1
      RECORD_BASENAMES+=("${f##*/}")
      if [ -n "$TARGET_CANON" ]; then
        F_CANON=$(_canon_path "$f")
        [ "$TARGET_CANON" = "$F_CANON" ] && RECORD_HIT=1
      fi
    fi
  done < <(find "$ACTIVE_DIR" -maxdepth 1 -type f -name 'IMPL-PLAN-*.md' 2>/dev/null)
fi
# AC10: fast allow-shortcut ONLY when we scanned every candidate and found no
# record. An oversized (unscanned) candidate keeps us going — hand off to
# autonomy-check.sh, which fails closed on it (exit 4 -> deny below).
if [ "$HAS_RECORD" -ne 1 ] && [ "$OVERSIZED_SEEN" -ne 1 ]; then
  exit 0
fi

# Deny-JSON builder (B5): jq when present (correctly escapes everything); the awk
# fallback additionally strips control chars [\001-\037] (not just backslash/quote)
# so a hostile path/message can never produce invalid JSON.
_deny() { # reason text -> prints deny JSON, exits 0
  local reason="$1" out esc
  if [ "$HAVE_JQ" -eq 1 ]; then
    out=$(jq -nc --arg reason "[autonomy-gate] $reason" \
      '{hookSpecificOutput:{hookEventName:"PreToolUse", permissionDecision:"deny", permissionDecisionReason:$reason}}' 2>/dev/null)
    if [ -n "$out" ]; then
      printf '%s\n' "$out"
      exit 0
    fi
  fi
  esc=$(printf '%s' "$reason" | awk '{ gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); gsub(/[\001-\037]/, ""); print }')
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"[autonomy-gate] %s"}}\n' "$esc"
  exit 0
}

# B3: the run record is immutable-by-agent while a run is active.
if [ "$RECORD_HIT" -eq 1 ]; then
  _deny "the active autonomy run record is not editable during a run — end the run to change scope/caps"
fi

# G4/AC9 (BEST-EFFORT, see header comment): any Bash command that references the
# active record (its basename or the literal "autonomy-run" marker) is DENIED. We do
# NOT try to distinguish a read from a write on arbitrary shell text — a read/write
# classifier was tried and cross-model review (Codex) found it trivially bypassable
# (`cat /dev/null; mv payload <record>` latches read-only on the leading `cat`, then
# writes via the second command), and STRICTLY WORSE than a blanket deny. So the
# blanket deny stands: it errs safe and cannot be defeated by command-chaining. To
# READ the record mid-run, use the Read tool, not Bash. This still does not catch a
# write that never names the record (variable/base64 indirection) — that residual is
# the documented, deferred operator decision, unchanged.
if [ "$TOOL_NAME" = "Bash" ] && [ -n "$CMD_TEXT" ]; then
  _refs_record=0
  for _bn in "${RECORD_BASENAMES[@]:-}"; do
    [ -n "$_bn" ] || continue
    case "$CMD_TEXT" in *"$_bn"*) _refs_record=1 ;; esac
  done
  case "$CMD_TEXT" in *autonomy-run*) _refs_record=1 ;; esac
  if [ "$_refs_record" -eq 1 ]; then
    _deny "the autonomy run record must not be touched via Bash during a run — read it with the Read tool, and end the run to change scope/caps"
  fi
fi

# B4: fold the pending target into the pre-hoc scope check for file-writing tools
# only (G3: TARGET_PATH is file_path or, for NotebookEdit, notebook_path). Bash has
# no reliable single target, so it stays post-hoc (no --pending) beyond the G4
# pattern-match above.
PENDING_ARG=""
case "$TOOL_NAME" in
  Edit|Write|MultiEdit|NotebookEdit)
    [ -n "$TARGET_PATH" ] && PENDING_ARG="--pending=$TARGET_PATH"
    ;;
esac

ARGS=("$PROJECT_DIR")
[ -n "$SESSION_ID" ] && ARGS+=("--session=$SESSION_ID")
[ -n "$PENDING_ARG" ] && ARGS+=("$PENDING_ARG")
OUTPUT=$("$CHECK_SCRIPT" "${ARGS[@]}" 2>&1)
RC=$?
[ "$RC" -eq 0 ] && exit 0

# 1/2/3/4 (any non-zero here) all mean STOP — deny with the script's own message.
REASON=$(printf '%s\n' "$OUTPUT" | awk 'NF{line=$0} END{print line}')
[ -n "$REASON" ] || REASON="[autonomy-check] blocked (exit $RC), no message captured."
_deny "$REASON"
