#!/bin/bash
# PreToolUse hook for Bash — checks git commit commands
# Review gate first (cheap, blocks immediately), then the test gate (1.50: suites
# and ui-tester / test-engineer checks bound to the commit's exact content —
# IMPL-PLAN testing-ui §5.4), then the compilation check, then a size signal for
# large files.

HAVE_JQ=1
command -v jq &>/dev/null || HAVE_JQ=0

INPUT=$(cat)

# jq-less fallback: the value of the first "command" key, JSON-unescaped (\" \\ \/
# \n \t \r; \uXXXX kept as is). Used ONLY to learn whether a repo with a test
# contract is being committed to (→ deny "install jq"); without a contract the
# gate stays fail-open exactly as before 1.50.
_crude_command() {
  printf '%s' "$INPUT" | LC_ALL=C awk 'BEGIN { RS = "\001" } { s = s $0 } END {
    i = index(s, "\"command\""); if (!i) exit
    s = substr(s, i + 9)
    if (!match(s, /^[ \t\r\n]*:[ \t\r\n]*"/)) exit
    s = substr(s, RLENGTH + 1); n = length(s); out = ""
    for (k = 1; k <= n; k++) {
      c = substr(s, k, 1)
      if (c == "\\") {
        k++; e = substr(s, k, 1)
        if (e == "n") out = out "\n"; else if (e == "t") out = out "\t"; else if (e == "r") out = out "\r"
        else if (e == "\"" || e == "\\" || e == "/") out = out e; else out = out "\\" e
      } else if (c == "\"") break
      else out = out c
    }
    printf "%s", out }'
}

# Contract marker in HEAD without the library (it failed to load): a marker line at
# column 0 in CLAUDE.md / AGENTS.md. Coarser than tc_contract_marker (ignores code
# fences) — used only on the broken-plugin path, where erring toward "contract
# present" (deny) is the safe side.
_crude_contract_in_head() { # <dir>
  local n
  for n in CLAUDE.md AGENTS.md; do
    git -C "$1" show "HEAD:$n" 2>/dev/null | grep -q '^<!-- subteams:test-suites v1 -->' && return 0
  done
  return 1
}

_tg_bypass_line="Bypass is the user's only: CLAUDE_SUBTEAMS_SKIP_TEST_GATE=1 in the environment Claude Code runs in — the model cannot set it (an inline VAR=1 in the command line does not reach this hook)."
_tg_deny() { # <reason…> — test-gate block: reason on stderr (the model sees only stderr on exit 2)
  printf '[subteams:pre-commit-gate] %s\n%s\n' "$*" "$_tg_bypass_line" >&2
  exit 2
}

if [ "$HAVE_JQ" -eq 1 ]; then
  COMMAND=$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)
else
  COMMAND=$(_crude_command)
fi

# Only act on a real `git commit`. hooks/lib-gitcmd.sh tokenizes the command line
# (quote-aware, so `echo "…git commit…"` is just an echo) and lists every git
# invocation: global options (`git -c x=y -C dir commit`), wrappers (`env git`,
# `timeout 60 git`, `/usr/bin/git`) and `bash -c "…"` / `if …; then git commit`
# are all seen; `git commit-tree` is a different subcommand and `--dry-run` / `-h`
# never create a commit. Cheap substring pre-filter first: non-commit Bash calls
# (the vast majority) skip the tokenizer entirely. A line that RUNS subteams-tests
# is checked too (B17, below), whatever else it does.
# The pre-filter looks at the NORMALIZED text (quotes and backslashes removed,
# $'…' escapes decoded), so `git com''mit`, `git co\mmit`, `git $'\x63ommit'` and a
# split-quoted subteams-tests are not skipped. RAW_COMMIT keeps the 1.49 answer
# for the review gate (parity: 1.49 skipped those lines entirely).
_norm_cmd() {
  printf '%s' "$1" | LC_ALL=C awk 'function hx(h,  i, v, c) { v = 0; for (i = 1; i <= length(h); i++) { c = index("0123456789abcdef", tolower(substr(h, i, 1))); if (!c) break; v = v * 16 + c - 1 } return v }
    function oc(o,  i, v) { v = 0; for (i = 1; i <= length(o); i++) v = v * 8 + substr(o, i, 1); return v }
    BEGIN { RS = "\001" } { s = s $0 } END {
      n = length(s); out = ""
      for (i = 1; i <= n; i++) {
        c = substr(s, i, 1)
        if (c == "$" && substr(s, i + 1, 1) == "\047") {
          for (i += 2; i <= n && substr(s, i, 1) != "\047"; i++) {
            c = substr(s, i, 1)
            if (c == "\\") {
              d = substr(s, i + 1, 1)
              if (d == "x" && match(substr(s, i + 2, 2), /^[0-9A-Fa-f]+/)) { out = out sprintf("%c", hx(substr(s, i + 2, RLENGTH))); i += 1 + RLENGTH; continue }
              if (match(substr(s, i + 1, 3), /^[0-7]+/)) { out = out sprintf("%c", oc(substr(s, i + 1, RLENGTH))); i += RLENGTH; continue }
              out = out d; i++; continue
            }
            out = out c
          }
          continue
        }
        if (c == "\047" || c == "\"" || c == "\\") continue
        out = out c
      }
      printf "%s", out }'
}
NORM_CMD=$(_norm_cmd "$COMMAND")
RAW_COMMIT=0; case "$COMMAND" in *commit*) RAW_COMMIT=1 ;; esac
ST_LINE=0
case "$NORM_CMD" in *subteams-tests*|*discover-tests*) ST_LINE=1 ;; esac
case "$NORM_CMD" in *commit*) ;; *) [ "$ST_LINE" -eq 1 ] || exit 0 ;; esac
# shellcheck source=lib-gitcmd.sh
if ! . "$(dirname "$0")/lib-gitcmd.sh" 2>/dev/null; then
  # Cannot parse the command at all. Before 1.50: fail open. A repo with a test
  # contract in HEAD must not lose its gate to a broken plugin install → deny.
  if [ "${CLAUDE_SUBTEAMS_SKIP_TEST_GATE:-0}" != "1" ] && case "$COMMAND" in *commit*) true ;; *) false ;; esac \
     && _crude_contract_in_head "$PWD"; then
    _tg_deny "Test gate: this repo has a test contract, but the plugin file hooks/lib-gitcmd.sh did not load, so the commit cannot be checked. Reinstall/update the claude-subteams plugin, then retry."
  fi
  exit 0
fi
# Statement-level scanner for the test gate (B13-B17); a load failure denies only
# where a contract is enforced (see the test gate).
CS_LIB=1; CS_SCANNED=0
# shellcheck source=lib-commitscan.sh
. "$(dirname "$0")/lib-commitscan.sh" 2>/dev/null || CS_LIB=0

# B17: a suite run whose environment is changed in the same line (VAR=… / env …
# prefix, export / declare / set / source earlier in the line) would leave a
# receipt for something other than the project's own command — deny, every repo.
if [ "$ST_LINE" -eq 1 ] && [ "$CS_LIB" -eq 1 ] && [ "${CLAUDE_SUBTEAMS_SKIP_TEST_GATE:-0}" != "1" ]; then
  cs_scan "$COMMAND"; CS_SCANNED=1
  for k in ${CS_KIND[@]+"${!CS_KIND[@]}"}; do
    [ "${CS_KIND[k]}" = st ] && [ "${CS_RUN[k]}" = 1 ] || continue
    if [ "${CS_ENV[k]}" = 1 ] || [ "${CS_PEXP[k]}" = 1 ]; then
      _tg_deny "Test gate: '${CS_TXT[k]}' runs a suite with a changed environment (VAR=… / env prefix, or export / set / source earlier in the same command). A receipt must reflect the project's own command: run 'subteams-tests run …' as its own command, without environment changes (put needed settings into the suite's cmd in the contract)."
    fi
  done
  case "$NORM_CMD" in *commit*) ;; *) exit 0 ;; esac
fi
# Shared test rules (docs-class for the review gate below, contract, receipts).
# A load failure no longer exits here: with a contract in HEAD it must deny (see
# the test gate), without one the gate keeps the old fail-open (exit 0 below).
TC_LIB=1
SCRIPTS_DIR="$(dirname "$0")/../scripts"
# shellcheck source=../scripts/lib-testclass.sh
. "$SCRIPTS_DIR/lib-testclass.sh" 2>/dev/null || TC_LIB=0
# temp dirs of this hook (commit-tree temp index, requirements work dir) go away
# even when the hook is killed by its timeout
if [ "$TC_LIB" -eq 1 ]; then
  trap 'tc_tmp_cleanup' EXIT; trap 'tc_tmp_cleanup; exit 143' TERM; trap 'tc_tmp_cleanup; exit 130' INT
fi

# Legacy detection (the pre-1.49 regex): used ONLY when the tokenizer says its
# parse is unreliable (unterminated quote, awk died, nesting cap). The principle
# of this gate: when unsure, err toward the OLD behaviour (detect via regex, file
# set = index), never toward opening the gate.
_legacy_has_commit() {
  printf '%s\n' "$COMMAND" | sed -E 's/&&|;|\|/\n/g' \
    | grep -qE '^\s*([A-Za-z_][A-Za-z0-9_]*=(\S*|"[^"]*"|'"'"'[^'"'"']*'"'"')\s+)*git\s+(-C\s+("[^"]*"|'"'"'[^'"'"']*'"'"'|\S+)\s+)?commit\b'
}

# Legacy target extraction (pre-1.49), used only when the parse is unreliable:
# prefer `git -C <path>` on the commit statement, else the last `cd <path>` before
# it (statements split on && / ;). A quoted span wins over whitespace-splitting.
_arg_after() { # $1=line  $2=extended-regex prefix
  printf '%s\n' "$1" | sed -nE "s/.*${2}\"([^\"]+)\".*/\1/p" | head -1 | grep . \
  || printf '%s\n' "$1" | sed -nE "s/.*${2}'([^']+)'.*/\1/p" | head -1 | grep . \
  || printf '%s\n' "$1" | sed -nE "s/.*${2}(\S+).*/\1/p" | head -1
}
_legacy_target() { # sets RAW_TARGET
  local STMT LAST_CD="" COMMIT_STMT=""
  while IFS= read -r STMT; do
    [ -z "$STMT" ] && continue
    if printf '%s\n' "$STMT" | grep -qE '^\s*cd\s+\S'; then
      LAST_CD=$(_arg_after "$STMT" '^\s*cd\s+')
    fi
    if printf '%s\n' "$STMT" | grep -qE '^\s*([A-Za-z_][A-Za-z0-9_]*=(\S*|"[^"]*"|'"'"'[^'"'"']*'"'"')\s+)*git\s+(-C\s+("[^"]*"|'"'"'[^'"'"']*'"'"'|\S+)\s+)?commit\b'; then
      COMMIT_STMT="$STMT"
      break
    fi
  done < <(printf '%s\n' "$COMMAND" | sed -E 's/&&|;/\n/g')
  RAW_TARGET=""
  if [ -n "$COMMIT_STMT" ] && printf '%s\n' "$COMMIT_STMT" | grep -qE '\bgit\s+-C\s+\S'; then
    RAW_TARGET=$(_arg_after "$COMMIT_STMT" '\bgit\s+-C\s+')
  elif [ -n "$LAST_CD" ]; then
    RAW_TARGET="$LAST_CD"
  fi
  RAW_TARGET="${RAW_TARGET%\"}"; RAW_TARGET="${RAW_TARGET#\"}"
  RAW_TARGET="${RAW_TARGET%\'}"; RAW_TARGET="${RAW_TARGET#\'}"
}

gitcmd_scan "$COMMAND"

# One entry per REAL commit in the command line (every commit is examined, not
# just the first; --dry-run / -h skip only their own commit).
CM_I=(); CM_ALL=(); CM_PATHS=(); CM_PFF=()
if [ "$GC_RELIABLE" -eq 1 ]; then
  for i in "${!GC_SUB[@]}"; do
    [ "${GC_SUB[$i]}" = "commit" ] || continue
    all=0; dry=0; skip=0; rest=0; cpaths=""; pff=""
    IFS=$'\037' read -r -a CARGS <<< "${GC_ARGS[$i]}"
    for a in "${CARGS[@]}"; do
      if [ "$skip" = pff ]; then pff="$a"; skip=0; continue; fi
      if [ "$skip" -eq 1 ]; then skip=0; continue; fi
      if [ "$rest" -eq 1 ]; then cpaths="${cpaths}${cpaths:+$'\037'}$a"; continue; fi
      case "$a" in
        --) rest=1 ;;
        --dry-run|--help) dry=1 ;;
        --all) all=1 ;;
        --pathspec-from-file) skip=pff ;;
        --pathspec-from-file=*) pff="${a#--pathspec-from-file=}" ;;
        --message|--file|--author|--date|--reuse-message|--reedit-message|--fixup|--squash|--cleanup|--template|--trailer) skip=1 ;;
        --*) ;;
        -h) dry=1 ;;
        -?*)
          # short-option cluster (`-am`, `-sam`, `-qvm`): scan chars until one that
          # takes a value (the rest of the cluster, or the next word, is that value)
          cl="${a#-}"
          while [ -n "$cl" ]; do
            ch="${cl:0:1}"; cl="${cl:1}"
            case "$ch" in
              a) all=1 ;;
              m|F|C|c|t) [ -z "$cl" ] && skip=1; break ;;
              u|S) break ;;
            esac
          done ;;
        *) cpaths="${cpaths}${cpaths:+$'\037'}$a" ;;
      esac
    done
    [ "$dry" -eq 0 ] || continue
    n=${#CM_I[@]}
    CM_I[n]=$i; CM_ALL[n]=$all; CM_PATHS[n]="$cpaths"; CM_PFF[n]="$pff"
  done
  if [ "${#CM_I[@]}" -eq 0 ]; then
    # A commit hidden behind quoting / escapes ($'\x63ommit'): the tokenizer does not
    # see it, the normalized text does. Under a contract in the cwd repo -> deny.
    if [ "$CS_LIB" -eq 1 ] && [ "${CLAUDE_SUBTEAMS_SKIP_TEST_GATE:-0}" != "1" ] && [ "$RAW_COMMIT" -eq 0 ]; then
      cs_scan "$NORM_CMD"
      for k in ${CS_KIND[@]+"${!CS_KIND[@]}"}; do
        [ "${CS_KIND[k]}" = git ] && [ "${CS_SUB[k]}" = commit ] || continue
        _hc_top=$(git rev-parse --show-toplevel 2>/dev/null)
        if [ -n "$_hc_top" ] && { if [ "$TC_LIB" -eq 1 ]; then case "$(tc_contract_marker "$_hc_top" head)" in v1|error) true ;; *) false ;; esac; else _crude_contract_in_head "$_hc_top"; fi; }; then
          _tg_deny "Test gate: this line runs a git commit spelled through quoting or escapes, and this repository has a test contract. Write the commit as a plain command: [cd /abs &&] [git add <literal paths> &&] git commit [-a] [-m '…' | -F - <<'EOF'] [-- <paths>] [&& read-only follow-ups]."
        fi
        break
      done
    fi
    exit 0
  fi
elif ! _legacy_has_commit; then
  exit 0
fi

ERRORS=""
NOTES=""

# P1.33: resolve the repo the commit actually targets. PreToolUse runs in the
# session's cwd, but the command may act on a different repo via
# `cd X && git commit` or `git -C X commit` — a bare `git diff --cached` below
# would then check the wrong repo's staging area (post-1.32 finding, see
# docs/plans/2026-07-13-subteams-1.32-research.md). Extraction is best-effort:
# prefer `git -C <path>` on the (first) commit statement itself, else the last
# `cd <path>` before it. ~ and $HOME expand; any other $ or ` in the path is an
# unresolvable substitution and we fall back to cwd rather than guess. Relative
# paths resolve against the session cwd. Unreliable parse: cwd.
TARGET_DIR="$PWD"
RAW_TARGET=""
FB_WIDE=0   # fallback only: "all modified tracked + untracked may be committed"
if [ "${#CM_I[@]}" -gt 0 ]; then
  RAW_TARGET="${GC_DIR[${CM_I[0]}]:-${GC_CD[${CM_I[0]}]}}"
else
  # Unreliable parse: keep the target repo (daily case: `cd /other/repo && git
  # commit -m "…"` with a message the tokenizer could not close), and keep the
  # set growing-only: an add/stage seen in the parsed prefix, or -a/--all/-am in
  # the raw text, widens it to every modified + untracked file.
  for i in "${!GC_SUB[@]}"; do
    case "${GC_SUB[$i]}" in
      commit) [ -n "$RAW_TARGET" ] || RAW_TARGET="${GC_DIR[$i]:-${GC_CD[$i]}}" ;;
      add|stage) FB_WIDE=1 ;;
    esac
  done
  printf '%s\n' "$COMMAND" | grep -qE 'commit\b.*(\s-[A-Za-z]*a[A-Za-z]*(\s|$)|--all\b)' && FB_WIDE=1
  [ -n "$RAW_TARGET" ] || _legacy_target
  [ -n "$RAW_TARGET" ] || RAW_TARGET="$GC_LASTCD"
fi

if [ -n "$RAW_TARGET" ]; then
  case "$RAW_TARGET" in
    '~'|'~/'*) RAW_TARGET="$HOME${RAW_TARGET#\~}" ;;
    '$HOME'|'$HOME/'*) RAW_TARGET="$HOME${RAW_TARGET#\$HOME}" ;;
  esac
  case "$RAW_TARGET" in
    *'$'*|*'`'*) RAW_TARGET="" ;;
  esac
  case "$RAW_TARGET" in
    /*|"") : ;;
    *) RAW_TARGET="$PWD/$RAW_TARGET" ;;
  esac
  if [ -n "$RAW_TARGET" ] && [ -d "$RAW_TARGET" ]; then
    TARGET_DIR="$RAW_TARGET"
  fi
fi

# ---- Test gate, cheap part (1.50, IMPL-PLAN testing-ui §5.4 steps 2-3 + review fixes B13-B16) ----
# The TEST gate decides on hooks/lib-commitscan.sh (a statement-level view of the
# line), not on the GC_* arrays of the review gate:
#   - target repo: the commit's own cd / git -C, simple VAR=literal assignments
#     earlier in the line resolved; still unresolvable -> deny "use a literal path";
#     commits into different repositories in one line -> deny "split";
#   - contract: marker in HEAD of the TARGET repo (HEAD^ for --amend: the commit
#     being replaced is not the reference); awk only, no jq; the crude grep when
#     the library failed to load. A merge / cherry-pick / revert / rebase in
#     progress -> warnings only (no deny, no "contract change alone" rule);
#   - with a contract (enforced): the commit must be the only state-changing
#     command of the line. Before it only: cd, read-only git, echo/printf/cat
#     without a file redirection into the repo, coord.sh commit-lock --, simple
#     VAR=value / export, and `git add|stage|rm` on the same repo (replayed). Not
#     allowed: anything else, -p/--patch/--interactive, GIT_INDEX_FILE / GIT_DIR /
#     GIT_WORK_TREE / --git-dir / --work-tree, several commits in one line, an
#     unreliable parse;
#   - the commit tree is COMPUTED as git will build it (tc_ct_* in lib-testclass:
#     -a, <paths>, -o, -i, --pathspec-from-file, preceding add/rm replayed on a
#     temp index). A message heredoc that the tokenizer split (`$(` inside "…"
#     with quotes) gives two readings: both trees are computed; different -> deny
#     "pass the message via -F -".
# No contract: warnings only, the computed tree when available (else the index).
TG_SKIP=0; [ "${CLAUDE_SUBTEAMS_SKIP_TEST_GATE:-0}" = "1" ] && TG_SKIP=1

_tg_in_progress() { # <repo> -> name of the operation in progress, or rc 1
  # MERGE_HEAD / CHERRY_PICK_HEAD must name a real commit NOT already reachable from
  # HEAD (a hand-written marker pointing at HEAD does not turn the gate into warnings);
  # REVERT_HEAD a real commit; a rebase dir its `onto` commit.
  local p n c
  for n in MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD rebase-merge rebase-apply; do
    p=$(git -C "$1" rev-parse --git-path "$n" 2>/dev/null) || continue
    case "$p" in /*) ;; *) p="$1/$p" ;; esac
    [ -e "$p" ] || continue
    case "$n" in
      rebase-*) c=$(head -n 1 "$p/onto" 2>/dev/null) ;;
      *) c=$(head -n 1 "$p" 2>/dev/null) ;;
    esac
    git -C "$1" rev-parse -q --verify "${c:-x}^{commit}" >/dev/null 2>&1 || continue
    case "$n" in MERGE_HEAD|CHERRY_PICK_HEAD) git -C "$1" merge-base --is-ancestor "$c" HEAD 2>/dev/null && continue ;; esac
    case "$n" in MERGE_HEAD) echo merge ;; CHERRY_PICK_HEAD) echo cherry-pick ;; REVERT_HEAD) echo revert ;; *) echo rebase ;; esac
    return 0
  done
  return 1
}

_tg_has_contract() { # <repo> -> 0 if an active test contract (marker v1 / broken) is in its HEAD
  local m
  [ -n "$1" ] || return 1
  if [ "$TC_LIB" -eq 1 ]; then m=$(tc_contract_marker "$1" head)
  elif _crude_contract_in_head "$1"; then m=v1; else m=absent; fi
  case "$m" in v1|error) return 0 ;; esac
  return 1
}

TG_REPO=""; TG_CK=-1; TG_NCOMMIT=0; TG_UNRES=""; TG_MULTI=""; TG_AMEND=0; TG_TOPS=""; TG_PREWARN=""
TG_CWDREPO=$(git rev-parse --show-toplevel 2>/dev/null)
if [ "$CS_LIB" -eq 1 ]; then
  [ "$CS_SCANNED" -eq 1 ] || { cs_scan "$COMMAND"; CS_SCANNED=1; }
  for k in ${CS_KIND[@]+"${!CS_KIND[@]}"}; do
    [ "${CS_KIND[k]}" = git ] && [ "${CS_SUB[k]}" = commit ] || continue
    cs_parse_commit "${CS_ARGS[k]}"
    [ "$CSP_DRY" -eq 0 ] || continue
    TG_NCOMMIT=$((TG_NCOMMIT + 1)); TG_CK=$k; TG_AMEND=$CSP_AMEND
    if [ -z "${CS_DIR[k]}" ]; then
      # R6: unresolvable target -> evaluate against the cwd repository
      TG_UNRES="${CS_DRAW[k]:-?}"; t="$TG_CWDREPO"
      [ -n "$t" ] || continue
    else
      t=$(cs_top_of "${CS_DIR[k]}") || continue          # not a directory / not a repo: git fails there
    fi
    case $'\n'"$TG_TOPS" in *$'\n'"$t"$'\n'*) ;; *) TG_TOPS="$TG_TOPS$t"$'\n' ;; esac
    if [ -n "$TG_REPO" ] && [ "$t" != "$TG_REPO" ]; then TG_MULTI="$TG_REPO and $t"; fi
    [ -n "$TG_REPO" ] || TG_REPO="$t"
  done
fi
# The scanner saw no commit (unreliable parse, scanner missing): the review gate's
# best-effort target.
[ "$TG_NCOMMIT" -gt 0 ] || TG_REPO=$(git -C "$TARGET_DIR" rev-parse --show-toplevel 2>/dev/null)

# A line whose control flow cannot be modelled (subshell, ||, &, substitutions, …)
# also makes the TARGET uncertain: `(cd /other) && git commit` commits in the cwd.
# So a shape violation is judged against the cwd repo AND every resolved target.
if [ "$TG_SKIP" -eq 0 ] && [ "$CS_LIB" -eq 1 ] && [ -n "$CS_SHAPE" ] && [ "$TG_NCOMMIT" -gt 0 ]; then
  _tg_any=0
  while IFS= read -r t; do [ -n "$t" ] && _tg_has_contract "$t" && { _tg_any=1; break; }; done <<< "$TG_TOPS$TG_CWDREPO"
  [ "$_tg_any" -eq 1 ] && _tg_deny "Test gate: this commit line is not a shape the gate can verify — it uses ${CS_SHAPE%%$'\n'*}. Under a test contract, $CS_SHAPE_HELP."
fi

# R6: a hard deny only where a contract is active; elsewhere a visible warning.
if [ "$TG_SKIP" -eq 0 ]; then
  if [ -n "$TG_MULTI" ]; then
    _tg_any=0
    while IFS= read -r t; do [ -n "$t" ] && _tg_has_contract "$t" && { _tg_any=1; break; }; done <<< "$TG_TOPS"
    [ "$_tg_any" -eq 1 ] && _tg_deny "Test gate: this command commits into different repositories ($TG_MULTI), and at least one has a test contract. Split it into separate commands, one commit each."
    TG_PREWARN="this command commits into different repositories ($TG_MULTI) — the test gate evaluated only $TG_REPO; split commits into separate commands."
  fi
  if [ -n "$TG_UNRES" ]; then
    _tg_has_contract "$TG_CWDREPO" && _tg_deny "Test gate: cannot tell which repository this commit targets ('$TG_UNRES' is not a literal path or a VAR=literal set earlier in the same command), and the current repository has a test contract. Use a literal path: cd /abs/repo && git commit … or git -C /abs/repo commit …"
    TG_PREWARN="${TG_PREWARN:+$TG_PREWARN }target repo could not be resolved ('$TG_UNRES'); test gate evaluated against ${TG_CWDREPO:-no repository (cwd is not a git repo)} — use a literal path."
  fi
fi

TG_BASE=HEAD; TG_CSRC=head; TG_HEADMARK=absent; TG_OP=""
if [ -n "$TG_REPO" ]; then
  if [ "$TG_AMEND" -eq 1 ]; then
    if git -C "$TG_REPO" rev-parse -q --verify 'HEAD^^{commit}' >/dev/null 2>&1; then TG_BASE='HEAD^'; TG_CSRC='rev:HEAD^'
    else TG_BASE=""; TG_CSRC=none; fi
  elif ! git -C "$TG_REPO" rev-parse -q --verify 'HEAD^{commit}' >/dev/null 2>&1; then TG_BASE=""
  fi
  if [ "$TG_CSRC" != none ]; then
    if [ "$TC_LIB" -eq 1 ]; then TG_HEADMARK=$(tc_contract_marker "$TG_REPO" "$TG_CSRC")
    elif _crude_contract_in_head "$TG_REPO"; then TG_HEADMARK=v1; fi
  fi
  TG_OP=$(_tg_in_progress "$TG_REPO") || TG_OP=""
fi
TG_CONTRACT=0; case "$TG_HEADMARK" in v1|error) TG_CONTRACT=1 ;; esac
# --amend of the commit that INTRODUCED the contract (HEAD has it, HEAD^ does not):
# the structural checks still apply, and the amended commit must stay contract-only.
TG_AMENDNEW=0
if [ "$TG_AMEND" -eq 1 ] && [ "$TG_CONTRACT" -eq 0 ] && [ -n "$TG_REPO" ] && _tg_has_contract "$TG_REPO"; then
  TG_AMENDNEW=1; TG_CONTRACT=1
fi
TG_ENFORCE=0; [ "$TG_CONTRACT" -eq 1 ] && [ -z "$TG_OP" ] && TG_ENFORCE=1
TG_TREE=""; TG_CT_MODE=""; CS_REPO="$TG_REPO"

if [ "$TG_ENFORCE" -eq 1 ] && [ "$TG_SKIP" -eq 0 ]; then
  if [ "$HAVE_JQ" -eq 0 ]; then
    _tg_deny "Test gate: this repo has a test contract (subteams:test-suites in CLAUDE.md/AGENTS.md of HEAD), but jq is not installed, so the commit cannot be checked. Install jq (apt install jq / brew install jq), then retry."
  fi
  if [ "$TC_LIB" -eq 0 ]; then
    _tg_deny "Test gate: this repo has a test contract, but the plugin file scripts/lib-testclass.sh did not load, so the commit cannot be checked. Reinstall/update the claude-subteams plugin, then retry."
  fi
  [ "$CS_LIB" -eq 1 ] || _tg_deny "Test gate: this repo has a test contract, but the plugin file hooks/lib-commitscan.sh did not load, so the commit cannot be checked. Reinstall/update the claude-subteams plugin, then retry."
  _tg_how="With a test contract the gate checks exactly what this commit will record."
  if [ "$CS_RELIABLE" -ne 1 ] || [ "$TG_NCOMMIT" -eq 0 ]; then
    _tg_deny "Test gate: this command line cannot be parsed reliably (an unterminated quote or an unusual construct), so the content of the commit cannot be determined. $_tg_how Under a test contract, $CS_SHAPE_HELP."
  fi
  [ "$TG_NCOMMIT" -gt 1 ] && _tg_deny "Test gate: several commits in one command line. $_tg_how Split them into separate commands, one commit each."
  for ((k = 0; k <= TG_CK; k++)); do
    [ "${CS_GENV[k]}" = 1 ] && _tg_deny "Test gate: '${CS_TXT[k]}' sets GIT_INDEX_FILE / GIT_DIR / GIT_WORK_TREE (or --git-dir / --work-tree / -c core.worktree) for this commit. $_tg_how Commit with the repository's own index and work tree; $CS_SHAPE_HELP."
  done
  cs_parse_commit "${CS_ARGS[TG_CK]}"
  [ "$CSP_PATCH" -eq 1 ] && _tg_deny "Test gate: git commit -p / --patch / --interactive picks content interactively. $_tg_how Stage the hunks separately (git add …), check with 'subteams-tests status', then commit."
  cs_prior_ok "$TG_CK" || _tg_deny "Test gate: $CS_BAD. Under a test contract, $CS_SHAPE_HELP."
  cs_redir_bad "$TG_CK" && _tg_deny "Test gate: the commit's output is redirected to '$CS_RB' inside the repository (the file is truncated before git runs). Redirect outside the repository or drop it."
  TG_CT_MODE=enforce            # the tree itself is computed in _test_gate, AFTER the review gate
elif [ "$CS_LIB" -eq 1 ] && [ "$TC_LIB" -eq 1 ] && [ "$HAVE_JQ" -eq 1 ] && [ "$CS_RELIABLE" -eq 1 ] \
     && [ "$TG_NCOMMIT" -eq 1 ] && [ -n "$TG_REPO" ] && [ "$TG_SKIP" -eq 0 ]; then
  # warn-only: best effort; any doubt -> the index tree (the old behaviour)
  cs_prior_ok "$TG_CK" && TG_CT_MODE=warn
fi

# Without jq the review gate below cannot run: the old fail-open (a contract repo
# was already handled above).
[ "$HAVE_JQ" -eq 1 ] || exit 0
# The review gate must not depend on the test library: a local copy of its
# docs-class when scripts/lib-testclass.sh did not load (kept identical to
# tc_is_docs_class — scripts/test-hooks.sh compares the two).
if [ "$TC_LIB" -eq 0 ]; then
  tc_is_docs_class() {
    local f="$1" had=0 rc=0
    [[ $f =~ ^(\.gitignore|\.editorconfig|\.gitattributes|package-lock\.json|yarn\.lock|pnpm-lock\.yaml|Cargo\.lock|go\.sum|poetry\.lock|uv\.lock|composer\.lock)$|(^|/)\.DS_Store$ ]] && return 0
    [[ $f =~ \.(md|txt|csv|rst|adoc)$ ]] || return 1
    shopt -q nocasematch && had=1
    shopt -s nocasematch
    [[ $f =~ (^|/)[^/]*(requirements|constraints)[^/]*\.txt$ ]] && rc=1
    [ "$had" -eq 1 ] || shopt -u nocasematch
    return "$rc"
  }
fi

# FILES = what THIS command can commit, not just what is staged now (PreToolUse
# runs before the command, so `git add -A && git commit` and `git commit -am`
# had an empty index here and sailed through). The set only ever WIDENS, never
# narrows: index ∪ pathspec paths of each commit ∪ paths of every `git add` /
# `git stage` earlier in the command line ∪ (commit -a) modified tracked files.
# Garbage "pathspecs" (leftovers of a mis-parsed message) therefore add nothing
# harmful. Dirty files that nothing in the command touches stay out, so a
# docs-only commit is not gated by a neighbour's unstaged .ts. A dynamic add
# (`git add "$f"`, `… | xargs git add`, --pathspec-from-file) is unknowable, so
# it counts as `add -A` (all modified tracked + untracked). core.quotePath=false:
# otherwise non-ASCII names come out octal-quoted ("\320\227….md") and miss the
# extension checks below.
FILES=$(
  G=(git -c core.quotePath=false -C "$TARGET_DIR")
  "${G[@]}" diff --cached --name-only 2>/dev/null
  if [ "$FB_WIDE" -eq 1 ]; then
    "${G[@]}" diff --name-only 2>/dev/null
    "${G[@]}" ls-files -o --exclude-standard --full-name -- ":/" 2>/dev/null
  fi
  last=-1
  for k in "${!CM_I[@]}"; do
    [ "${CM_I[$k]}" -gt "$last" ] && last=${CM_I[$k]}
    [ "${CM_ALL[$k]}" -eq 1 ] && "${G[@]}" diff --name-only 2>/dev/null
    if [ -n "${CM_PFF[$k]:-}" ]; then
      # --pathspec-from-file (1.49 missed it): the listed paths; unreadable / stdin ->
      # everything modified + untracked, as for any dynamic pathspec
      _pf="${CM_PFF[$k]}"; case "$_pf" in /*) ;; *) _pf="$TARGET_DIR/$_pf" ;; esac
      if [ "${CM_PFF[$k]}" != - ] && [ -f "$_pf" ] && [ -r "$_pf" ]; then
        PS=(); while IFS= read -r _l || [ -n "$_l" ]; do _l="${_l%$'\r'}"; [ -n "$_l" ] && PS+=("$_l"); done < "$_pf"
        if [ "${#PS[@]}" -gt 0 ]; then
          "${G[@]}" diff HEAD --name-only -- "${PS[@]}" 2>/dev/null || "${G[@]}" ls-files --full-name -- "${PS[@]}" 2>/dev/null
          "${G[@]}" ls-files -o --exclude-standard --full-name -- "${PS[@]}" 2>/dev/null
        fi
      else
        "${G[@]}" diff --name-only -- ":/" 2>/dev/null
        "${G[@]}" ls-files -o --exclude-standard --full-name -- ":/" 2>/dev/null
      fi
    fi
    if [ -n "${CM_PATHS[$k]}" ]; then
      IFS=$'\037' read -r -a PS <<< "${CM_PATHS[$k]}"
      "${G[@]}" diff HEAD --name-only -- "${PS[@]}" 2>/dev/null \
        || "${G[@]}" ls-files --full-name -- "${PS[@]}" 2>/dev/null
      "${G[@]}" ls-files -o --exclude-standard --full-name -- "${PS[@]}" 2>/dev/null
    fi
  done
  for i in "${!GC_SUB[@]}"; do
    [ "$i" -lt "$last" ] || continue
    case "${GC_SUB[$i]}" in add|stage) ;; *) continue ;; esac
    mode=""; paths=(); dyn="${GC_X[$i]:-0}"; skip=0; rest=0
    IFS=$'\037' read -r -a AARGS <<< "${GC_ARGS[$i]}"
    for a in "${AARGS[@]}"; do
      if [ "$skip" -eq 1 ]; then skip=0; continue; fi
      case "$a" in *'$'*|*'`'*) dyn=1 ;; esac
      if [ "$rest" -eq 1 ]; then paths+=("$a"); continue; fi
      case "$a" in
        --) rest=1 ;;
        --all) mode=all ;;
        --update) mode="${mode:-upd}" ;;
        --chmod) skip=1 ;;
        --pathspec-from-file|--pathspec-from-file=*) dyn=1; [ "$a" = "--pathspec-from-file" ] && skip=1 ;;
        --*) ;;
        -?*)
          cl="${a#-}"
          while [ -n "$cl" ]; do
            ch="${cl:0:1}"; cl="${cl:1}"
            case "$ch" in A) mode=all ;; u) mode="${mode:-upd}" ;; esac
          done ;;
        *) paths+=("$a") ;;
      esac
    done
    if [ "$dyn" -eq 1 ]; then
      "${G[@]}" diff --name-only -- ":/" 2>/dev/null
      "${G[@]}" ls-files -o --exclude-standard --full-name -- ":/" 2>/dev/null
    fi
    if [ "${#paths[@]}" -eq 0 ]; then
      [ -n "$mode" ] || continue
      paths=(":/")
    fi
    "${G[@]}" diff --name-only -- "${paths[@]}" 2>/dev/null
    [ "$mode" = "upd" ] || "${G[@]}" ls-files -o --exclude-standard --full-name -- "${paths[@]}" 2>/dev/null
  done
)
FILES=$(printf '%s\n' "$FILES" | sort -u)

# P3.1 review gate: the commit's code changes require a code-reviewer subagent
# to have FINISHED this session. hooks/subagent-rails writes the marker on
# SubagentStop (agent_type matches code-reviewer / gpt-code-reviewer, result not
# blank); we just check it's there. Escape hatch:
# CLAUDE_SUBTEAMS_SKIP_REVIEW_GATE=1 — an env var of the CLI process, so only
# the user can set it; the block message tells the model to ask, not to try.
# Fails open (no block) when session_id can't be read from stdin — we can't
# prove a review is missing if we can't identify the session, so we don't guess.
# Coarse-grained by design: "did code-reviewer run at all this session", not
# "did it review exactly these lines" — matches the plan's scope.
# Runs BEFORE the compilation check on purpose: it is cheap and blocks at once,
# whereas tsc can run for tens of seconds and a hook killed by its timeout is a
# non-blocking error (the commit would go through unreviewed).
SID=$(printf '%s' "$INPUT" | jq -r '.session_id // empty' 2>/dev/null)
if [ "${CLAUDE_SUBTEAMS_SKIP_REVIEW_GATE:-0}" != "1" ] && [ "$RAW_COMMIT" -eq 1 ]; then
  if [ -n "$SID" ] && printf '%s' "$SID" | grep -qE '^[A-Za-z0-9._-]+$' \
     && [ "$SID" != "." ] && [ "$SID" != ".." ]; then
    HAS_CODE=0
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      # Docs-class (neutral repo metadata + prose/data formats; requirements /
      # constraints .txt stay gated) — one definition, shared with the test
      # gate: tc_is_docs_class in scripts/lib-testclass.sh.
      tc_is_docs_class "$f" && continue
      HAS_CODE=1
      CODE_EXAMPLE="$f"
      break
    done <<< "$FILES"

    if [ "$HAS_CODE" -eq 1 ]; then
      case "${XDG_CACHE_HOME:-}" in /*) _cr="$XDG_CACHE_HOME" ;; *) _cr="$HOME/.cache" ;; esac   # = tc_cache_root
      MARK_FILE="$_cr/claude-subteams/review-marks/$SID"
      if [ ! -f "$MARK_FILE" ]; then
        # Delivery contract (Claude Code hooks): on exit 2 the model sees only
        # STDERR — stdout was shown as "No stderr output", so the reason never
        # reached it. Block reasons therefore go to stderr (chosen over
        # autonomy-gate's JSON deny: no jq/escaping dependency on the failure
        # path, and a deny keeps working in every permission mode).
        echo "[subteams:pre-commit-gate] This commit includes code changes (e.g. $CODE_EXAMPLE) and no code-reviewer subagent has finished in this session. Run the code-reviewer subagent on these changes, wait for its result, then retry the commit. If the user said to skip review, ask the user to set CLAUDE_SUBTEAMS_SKIP_REVIEW_GATE=1 in the environment Claude Code runs in — the model cannot set it from inside the session." >&2
        exit 2
      fi
    fi
  fi
fi

# ---- Test gate, full part (1.50, IMPL-PLAN testing-ui §5.4 steps 4-8) ----
# The rules themselves live in ONE place: tc_requirements (scripts/lib-testclass.sh),
# the same function `subteams-tests status` reports. Here: which tree, which
# contract, and what to do with the verdict.
#   commit tree = TG_TREE computed above (what git will record), else write-tree
#                 of a COPY of the real index (never written);
#   contract    = from HEAD (R11; HEAD^ for --amend). A commit that changes the
#                 effective contract (read from the COMMIT TREE: file, state or
#                 content; removal and `none` included) passes only if it contains
#                 nothing but the contract file(s) — with a warning;
#   HEAD contract → deny listing EVERYTHING missing; staged-only contract ("new
#   contract") or no contract → allow + a warning to the user and the model;
#   merge / cherry-pick / revert / rebase in progress → warnings only;
#   `none` marker (base or commit) → silent.
# Without a contract the heuristic config comes from `discover-tests.sh config`;
# any failure on that warn-only path is a silent allow.
TG_WARN=""      # one-line summary for the user (systemMessage)
TG_DETAIL=""    # details for the model (additionalContext)
_tg_warn() { TG_WARN="${TG_WARN}${TG_WARN:+ | }$1"; [ -n "${2:-}" ] && TG_DETAIL="${TG_DETAIL}${TG_DETAIL:+
}$2"; return 0; }
_tg_items() { # missing lines -> "a, b, c" (each line up to its first ": " — suite names may contain ':')
  printf '%s\n' "$1" | awk '{ i = index($0, ": "); if (i > 1) print substr($0, 1, i - 1) }' | paste -sd, - | sed 's/,/, /g'
}
_tg_list() { printf '%s\n' "$1" | sed '/^$/d; s/^/  - /'; }
[ -n "${TG_PREWARN:-}" ] && _tg_warn "$TG_PREWARN"
_tg_warns() { # TC_REQ_WARN lines -> _tg_warn each
  local w
  while IFS= read -r w; do [ -n "$w" ] && _tg_warn "$w"; done <<< "${TC_REQ_WARN:-}"
  return 0
}
_tg_anchor() { # on allow only: write the drift anchors tc_requirements asked for (TC_REQ_ANCHORS)
  local g t c
  while read -r g t c; do [ -n "$t" ] && tc_anchor_write "$TG_REPO" "$g" "$t" "$c"; done <<< "${TC_REQ_ANCHORS:-}"
  _tg_warns
  return 0
}
_tg_deny_notes() { # notes for a deny text: warnings (never the threshold numbers) + large untracked files
  local w big
  while IFS= read -r w; do
    [ -n "$w" ] || continue
    case "$w" in *clamped*) w="small_change in the contract is above the built-in ceiling and was clamped to it." ;; esac
    printf '\nNote: %s' "$w"
  done <<< "${TC_REQ_WARN:-}"
  [ "${TC_RECEIPTS_CAPPED:-0}" -gt 0 ] && printf '\nNote: only the newest %s receipts per type were considered (%s older ones ignored).' "$TC_RECEIPT_CAP" "$TC_RECEIPTS_CAPPED"
  big=$(tc_large_untracked "$TG_REPO" | paste -sd, - | sed 's/,/, /g')
  [ -n "$big" ] && printf '\nNote: large untracked files make every content snapshot slow: %s — add them to .gitignore or move them out.' "$big"
  return 0
}

_test_gate() {
  local tree base btree files hrc irc hst ist hfile ifile hsha isha hjson ijson herr ierr f only cfg names rc
  # The commit tree (replays git add / -a on a temp index: it can take time on a
  # big tree) is computed here, after the cheap review gate, so a hook killed by
  # its timeout never skips the review gate.
  case "$TG_CT_MODE" in
    enforce)
      cs_commit_tree "$TG_CK"; rc=$?
      case "$rc" in
        0) TG_TREE="$CS_TREE" ;;
        3) _tg_deny "Test gate: git would refuse this commit — ${CS_CTERR:-unknown reason}. Fix the command; stage separately if in doubt, then commit." ;;
        4) _tg_deny "Test gate: $CS_CTERR. Pass the message as a heredoc on stdin: git commit -F - <<'EOF' … EOF." ;;
        *) _tg_deny "Test gate: cannot compute the content of this commit — ${CS_CTERR:-internal error}. Stage separately (git add …), check with 'subteams-tests status', then commit with a plain 'git commit -m …'." ;;
      esac ;;
    warn) if cs_commit_tree "$TG_CK"; then TG_TREE="$CS_TREE"; else TG_TREE=""; fi ;;
  esac
  if [ -n "$TG_TREE" ]; then tree="$TG_TREE"
  else
    tree=$(tc_index_tree "$TG_REPO") || {
      [ "$TG_ENFORCE" -eq 1 ] && _tg_deny "Test gate: cannot compute the tree of the staged commit (unresolved merge in the index?). Resolve and stage, then retry."
      return 0; }
  fi
  if [ "$TG_AMEND" -eq 1 ] && [ "$tree" = "$(git -C "$TG_REPO" rev-parse -q --verify 'HEAD^{tree}' 2>/dev/null)" ]; then
    return 0                                   # amend without a content change: as before 1.50
  fi
  if [ -n "$TG_BASE" ]; then base="$TG_BASE"; btree=$(git -C "$TG_REPO" rev-parse "$TG_BASE^{tree}" 2>/dev/null)
  else base=$(tc_empty_tree "$TG_REPO"); btree="$base"; fi
  [ "$tree" = "$btree" ] && return 0          # nothing staged: nothing to check
  files=$(tc_changed_files "$TG_REPO" "$base" "$tree") || {
    [ "$TG_ENFORCE" -eq 1 ] && _tg_deny "Test gate: git diff of the staged commit failed — cannot check it. Retry; if it persists, check the repository state."
    return 0; }

  if [ "$TG_CSRC" = none ]; then hrc=1; hst=absent; hfile=""; hsha=""; hjson=""; herr=""
  else
    tc_contract_load "$TG_REPO" "$TG_CSRC"; hrc=$?
    hst="$TC_CONTRACT_STATE"; hfile="$TC_CONTRACT_FILE"; hsha="$TC_CONTRACT_SHA"; hjson="$TC_CONTRACT_JSON"; herr="$TC_ERR"
  fi
  tc_contract_load "$TG_REPO" "rev:$tree"; irc=$?
  ist="$TC_CONTRACT_STATE"; ifile="$TC_CONTRACT_FILE"; isha="$TC_CONTRACT_SHA"; ijson="$TC_CONTRACT_JSON"; ierr="$TC_ERR"

  if [ "$TG_ENFORCE" -eq 1 ] && [ "$hrc" -ne 1 ] && [ "$hrc" -ne 4 ]; then
    if [ "$hst|$hfile|$hsha" != "$ist|$ifile|$isha" ]; then          # step 5: contract changed
      [ "$irc" -eq 2 ] && _tg_deny "Test gate: the staged test contract is invalid — ${ierr:-broken}. Fix it; a contract change is committed alone."
      only=1
      while IFS= read -r f; do
        [ -z "$f" ] || [ "$f" = "$hfile" ] || [ "$f" = "$ifile" ] || { only=0; break; }
      done <<< "$files"
      [ "$only" -eq 1 ] || _tg_deny "Test gate: this commit changes the test contract (${ifile:-$hfile}) together with other files. Commit the contract change ALONE (only that file staged), then the rest: code is checked against the contract that is already committed."
      case "$ist" in
        v1) names=$(printf '%s' "$ijson" | jq -r '[.suites[] | "\(.name) (\(.run))"] | join(", ")' 2>/dev/null)
            _tg_warn "test contract changed in ${ifile} — suites now: ${names:-none}. This commit is not checked against the new rules; they apply from the next commit." ;;
        none) _tg_warn "test contract replaced by the 'none' marker in ${ifile} — from the next commit the test gate is silent (no checks, no warnings)." ;;
        *) _tg_warn "test contract removed from ${hfile} — from the next commit the test gate only warns." ;;
      esac
      return 0
    fi
    [ "$hrc" -eq 0 ] || _tg_deny "Test gate: the test contract in HEAD (${hfile:-CLAUDE.md}) is broken — ${herr:-unreadable}. Fix it in a commit that contains only ${hfile:-that file}, then retry this one."
    tc_requirements "$TG_REPO" "$tree" "$base" "$hjson" "$hsha" \
      || _tg_deny "Test gate: cannot evaluate the checks for this commit — ${TC_ERR:-unknown error}."
    if [ "$TC_REQ_OK" -eq 1 ]; then _tg_anchor; return 0; fi
    _tg_deny "Test gate (contract in ${hfile}): the exact content of this commit is not covered by the required checks. Missing:
$(_tg_list "$TC_REQ_MISSING")
Follow using-subteams §6.7 (ui-tester → test-engineer → subteams-tests run --all-auto); 'subteams-tests status' shows what is still missing. Then retry the commit.$(_tg_deny_notes)"
  fi

  if [ -n "$TG_OP" ] && [ "$TG_CONTRACT" -eq 1 ]; then              # merge & co. in progress: warn only
    if [ "$hrc" -eq 0 ] && tc_requirements "$TG_REPO" "$tree" "$base" "$hjson" "$hsha"; then
      _tg_warns
      if [ "$TC_REQ_OK" -eq 1 ]; then return 0; fi
      _tg_warn "$TG_OP in progress — the test gate only warns; not checked in this commit: $(_tg_items "$TC_REQ_MISSING")." \
        "Missing for this commit (warning only while a $TG_OP is in progress):
$(_tg_list "$TC_REQ_MISSING")"
    else
      _tg_warn "$TG_OP in progress — the test gate only warns and could not evaluate this commit${herr:+ ($herr)}."
    fi
    return 0
  fi

  # `none` marker: the user declined a contract — no warnings at all
  # (a staged v1 over a HEAD `none` is a new contract: its notice below still shows)
  if [ "$ist" = none ] || { [ "$hst" = none ] && [ "$irc" -ne 0 ]; }; then return 0; fi

  if [ "$TG_AMENDNEW" -eq 1 ] && [ "$TG_SKIP" -eq 0 ]; then          # amend of the contract-introducing commit
    only=1
    while IFS= read -r f; do
      [ -z "$f" ] || [ "$f" = "$ifile" ] || [ "$f" = CLAUDE.md ] || [ "$f" = AGENTS.md ] || { only=0; break; }
    done <<< "$files"
    [ "$only" -eq 1 ] || _tg_deny "Test gate: this amends the commit that introduced the test contract and adds other files to it — a contract change is committed ALONE. Commit the other files separately (they are then checked against the contract)."
  fi
  if [ "$irc" -eq 0 ] && [ "$hst" != v1 ]; then                       # "new contract" mode
    if tc_requirements "$TG_REPO" "$tree" "$base" "$ijson" "$isha"; then
      _tg_anchor
      if [ "$TC_REQ_OK" -eq 1 ]; then
        _tg_warn "new test contract staged in ${ifile} — enforced from the next commit."
      else
        _tg_warn "new test contract staged in ${ifile} (enforced from the next commit); not checked in this commit: $(_tg_items "$TC_REQ_MISSING")." \
          "Missing for this commit (warning only — the contract is not in HEAD yet):
$(_tg_list "$TC_REQ_MISSING")"
      fi
    fi
    return 0
  fi
  [ "$irc" -eq 2 ] && [ "$hst" != v1 ] && _tg_warn "the staged test contract in ${ifile:-CLAUDE.md} is invalid — ${ierr:-broken}; it will not be enforced."

  # No contract: heuristics, warning only. Docs-only → nothing to say.
  only=1
  while IFS= read -r f; do [ -n "$f" ] && ! tc_is_docs_class "$f" && { only=0; break; }; done <<< "$files"
  [ "$only" -eq 0 ] || return 0
  cfg=$(bash "$SCRIPTS_DIR/discover-tests.sh" --root "$TG_REPO" config 2>/dev/null | jq -c '.config' 2>/dev/null) || return 0
  [ -n "$cfg" ] && [ "$cfg" != null ] || return 0
  tc_requirements "$TG_REPO" "$tree" "$base" "$cfg" none || return 0
  _tg_anchor
  [ "$TC_REQ_OK" -eq 1 ] && return 0
  _tg_warn "no test contract (warning only, not blocking): this commit has no matching checks — $(_tg_items "$TC_REQ_MISSING")." \
    "Missing checks (no contract → not enforced; using-subteams §6.7 describes the flow):
$(_tg_list "$TC_REQ_MISSING")"
}

TC_SELF_ID="${SID:0:8}"          # this instance's coord id (session-start registers ${session_id:0:8})
if [ -n "$TG_REPO" ] && [ "$TC_LIB" -eq 1 ]; then
  if [ "$TG_SKIP" -eq 0 ]; then
    _test_gate
  elif [ "$TG_CONTRACT" -eq 1 ]; then
    _tg_warn "test gate bypassed: CLAUDE_SUBTEAMS_SKIP_TEST_GATE=1 is set in Claude Code's environment — this commit is not checked against the test contract."
  fi
fi

# Stack-agnostic compilation check — intentionally cwd-scoped (the session's
# active project), NOT TARGET_DIR: compiling a best-effort-resolved foreign
# repo would add noise; the review gate above is what goes cross-repo.
# Capped at 45 s (when `timeout` exists) so the hook always finishes inside its
# 60 s budget: a killed hook is a NON-blocking error, so a slow build must end as
# a note, not as a silent pass-through. Timeout (rc 124) => note, not a verdict.
TMO=()
command -v timeout &>/dev/null && TMO=(timeout 45)

# _run_check <label> <command...>: runs it capped; rc 0 ok, rc 124 note, else ERRORS.
_run_check() {
  local label="$1" out rc; shift
  out=$("${TMO[@]}" "$@" 2>&1); rc=$?
  if [ "$rc" -eq 124 ] && [ "${#TMO[@]}" -gt 0 ]; then
    NOTES="${NOTES}${NOTES:+
}[subteams:pre-commit-gate] $label did not finish in 45s — compilation NOT verified; run it yourself before relying on this commit."
  elif [ "$rc" -ne 0 ]; then
    ERRORS="[subteams:pre-commit-gate] $label failed:\n$(printf '%s' "$out" | head -200)\n\nFix before committing."
  fi
}

if [ -f "tsconfig.json" ]; then
  # Source nvm if available (hooks run in minimal shell without .bashrc) — only
  # needed here, inside the git-commit branch, so non-commit calls never pay for it.
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

  if command -v npx &>/dev/null; then
    _run_check "TypeScript compilation" npx tsc --noEmit
  else
    NOTES="[subteams:pre-commit-gate] Warning: npx not found in PATH — skipping TypeScript check. Ensure nvm is set up or node is installed globally."
  fi
elif [ -f "pyproject.toml" ] || [ -f "setup.py" ]; then
  if command -v mypy &>/dev/null; then
    _run_check "mypy check" mypy . --no-error-summary
  fi
elif [ -f "go.mod" ]; then
  if command -v go &>/dev/null; then
    _run_check "Go build" go build ./...
  else
    NOTES="[subteams:pre-commit-gate] Warning: go not found in PATH — skipping Go build check."
  fi
fi

# Size check (P9, cohesion doctrine — mirrors hooks/post-edit-check): when the
# project has a CONVENTIONS.md at the repo root, size thresholds and the
# cohesion principle live there and are enforced by review, not this hook.
# Without CONVENTIONS.md: flag code files in this commit past 400 lines as a
# review signal ("still one semantic unit?"), never as a verdict.
# 400 vs the 300 review threshold in prose: deliberately coarser — the hook is
# a last-resort net, review owns the 300 line; avoids mechanical noise.
# REPO_ROOT and the file list are resolved against TARGET_DIR (see above) — the
# repo the commit actually targets, not necessarily cwd. Paths from git are
# relative to the repo root, so file checks below join against REPO_ROOT rather
# than assuming cwd == root.
REPO_ROOT=$(git -C "$TARGET_DIR" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$TARGET_DIR")
LARGE_FILES=""
if [ ! -f "$REPO_ROOT/CONVENTIONS.md" ]; then
  LARGE_FILES=$(printf '%s\n' "${FILES:-}" | while IFS= read -r f; do
    FULL="$REPO_ROOT/$f"
    if [ -f "$FULL" ] && printf '%s\n' "$f" | grep -qE '\.(ts|js|py|go|rs|java|tsx|jsx)$'; then
      LINES=$(wc -l < "$FULL")
      if [ "$LINES" -gt 400 ]; then
        echo "  $f ($LINES lines)"
      fi
    fi
  done)
fi

if [ -n "$ERRORS" ]; then
  echo -e "$ERRORS" >&2
  exit 2
fi

# Advisory text: PreToolUse stdout on exit 0 is not shown to the model, so it goes
# out as hookSpecificOutput.additionalContext.
if [ -n "$LARGE_FILES" ]; then
  NOTES="${NOTES}${NOTES:+
}[subteams:pre-commit-gate] Size signal — files past 400 lines in this commit:
$LARGE_FILES
Check: is each still one semantic unit (cohesion)? If yes, keep with a one-line justification; if no, split along its actual seams."
fi

# One JSON object for the whole hook output. Test-gate warnings go to BOTH
# channels (IMPL-PLAN §5.4: systemMessage visibility from PreToolUse is not
# guaranteed, so additionalContext asks the model to relay it — as
# hooks/session-end-reminder does); NOTES stay model-only as before.
if [ -n "$TG_WARN" ]; then
  TG_MSG="[subteams:test-gate] $TG_WARN"
  CS_CTX="[subteams:test-gate] Automated commit-gate warning — NOT a user message, NOT a block (the commit proceeds). Relay it to the user in ONE short line in your next message; do not start extra work only because of it unless the user asks.
$TG_MSG${TG_DETAIL:+
$TG_DETAIL}${NOTES:+

$NOTES}"
  jq -nc --arg m "$TG_MSG" --arg c "$CS_CTX" '{systemMessage:$m, hookSpecificOutput:{hookEventName:"PreToolUse", additionalContext:$c}}'
elif [ -n "$NOTES" ]; then
  jq -nc --arg c "$NOTES" '{hookSpecificOutput:{hookEventName:"PreToolUse", additionalContext:$c}}'
fi

exit 0
