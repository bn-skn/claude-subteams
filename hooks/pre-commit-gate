#!/bin/bash
# PreToolUse hook for Bash — checks git commit commands
# Runs compilation check and warns about large files

# Check jq availability
if ! command -v jq &>/dev/null; then
  exit 0
fi

INPUT=$(cat)
COMMAND=$(printf '%s' "$INPUT" | jq -r '.tool_input.command // empty' 2>/dev/null)

# Only act on commands containing git commit (skip echo/printf/comments).
# Allows an intervening `-C <path>` so `git -C /other/repo commit` isn't
# missed — the review gate below needs to see these to resolve TARGET_DIR.
if ! printf '%s\n' "$COMMAND" | grep -qE '\bgit\s+(-C\s+("[^"]*"|'"'"'[^'"'"']*'"'"'|\S+)\s+)?commit\b'; then
  exit 0
fi
if printf '%s\n' "$COMMAND" | grep -qE '^\s*(echo|printf|#)'; then
  exit 0
fi

ERRORS=""

# Stack-agnostic compilation check — intentionally cwd-scoped (the session's
# active project), NOT TARGET_DIR: compiling a best-effort-resolved foreign
# repo would add noise; the review gate below is what goes cross-repo.
if [ -f "tsconfig.json" ]; then
  # Source nvm if available (hooks run in minimal shell without .bashrc) — only
  # needed here, inside the git-commit branch, so non-commit calls never pay for it.
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

  if command -v npx &>/dev/null; then
    if ! TSC_OUTPUT=$(npx tsc --noEmit 2>&1); then
      ERRORS="[subteams:pre-commit-gate] TypeScript compilation failed:\n$TSC_OUTPUT\n\nFix compilation errors before committing."
    fi
  else
    echo "[subteams:pre-commit-gate] Warning: npx not found in PATH — skipping TypeScript check. Ensure nvm is set up or node is installed globally."
  fi
elif [ -f "pyproject.toml" ] || [ -f "setup.py" ]; then
  if command -v mypy &>/dev/null; then
    if ! MYPY_OUTPUT=$(mypy . --no-error-summary 2>&1 | head -20); then
      ERRORS="[subteams:pre-commit-gate] mypy check found issues:\n$MYPY_OUTPUT"
    fi
  fi
elif [ -f "go.mod" ]; then
  if command -v go &>/dev/null; then
    if ! GO_OUTPUT=$(go build ./... 2>&1); then
      ERRORS="[subteams:pre-commit-gate] Go build failed:\n$GO_OUTPUT"
    fi
  else
    echo "[subteams:pre-commit-gate] Warning: go not found in PATH — skipping Go build check."
  fi
fi

# P1.33: resolve the repo the commit actually targets. PreToolUse runs in the
# session's cwd, but the command may act on a different repo via
# `cd X && git commit` or `git -C X commit` — a bare `git diff --cached` below
# would then check the wrong repo's staging area (post-1.32 finding, see
# docs/plans/2026-07-13-subteams-1.32-research.md). Extraction is best-effort:
# prefer `git -C <path>` on the commit statement itself, else the last `cd
# <path>` before it (split on && / ;). ~ and $HOME expand; any other $ or `
# in the path is an unresolvable substitution and we fall back to cwd rather
# than guess. Relative paths resolve against the session cwd.
TARGET_DIR="$PWD"
COMMIT_STMT=""
LAST_CD=""

# Extract the argument after a prefix (`cd ` / `git -C `): a quoted span wins
# over whitespace-splitting, so `cd "/path with space"` resolves whole instead
# of truncating at the space (review finding F2 — a truncated prefix that
# happens to be a real repo would silently point the gate at the WRONG repo).
_arg_after() { # $1=line  $2=extended-regex prefix
  printf '%s\n' "$1" | sed -nE "s/.*${2}\"([^\"]+)\".*/\1/p" | head -1 | grep . \
  || printf '%s\n' "$1" | sed -nE "s/.*${2}'([^']+)'.*/\1/p" | head -1 | grep . \
  || printf '%s\n' "$1" | sed -nE "s/.*${2}(\S+).*/\1/p" | head -1
}

while IFS= read -r STMT; do
  [ -z "$STMT" ] && continue
  if printf '%s\n' "$STMT" | grep -qE '^\s*cd\s+\S'; then
    LAST_CD=$(_arg_after "$STMT" '^\s*cd\s+')
  fi
  if printf '%s\n' "$STMT" | grep -qE '\bgit\s+(-C\s+("[^"]*"|'"'"'[^'"'"']*'"'"'|\S+)\s+)?commit\b'; then
    COMMIT_STMT="$STMT"
    break
  fi
done < <(printf '%s\n' "$COMMAND" | sed -E 's/&&|;/\n/g')

RAW_TARGET=""
if [ -n "$COMMIT_STMT" ] && printf '%s\n' "$COMMIT_STMT" | grep -qE '\bgit\s+-C\s+\S'; then
  RAW_TARGET=$(_arg_after "$COMMIT_STMT" '\bgit\s+-C\s+')
elif [ -n "$LAST_CD" ]; then
  RAW_TARGET="$LAST_CD"
fi

if [ -n "$RAW_TARGET" ]; then
  RAW_TARGET="${RAW_TARGET%\"}"; RAW_TARGET="${RAW_TARGET#\"}"
  RAW_TARGET="${RAW_TARGET%\'}"; RAW_TARGET="${RAW_TARGET#\'}"
  case "$RAW_TARGET" in
    '~'|'~/'*) RAW_TARGET="$HOME${RAW_TARGET#\~}" ;;
    '$HOME'|'$HOME/'*) RAW_TARGET="$HOME${RAW_TARGET#\$HOME}" ;;
  esac
  case "$RAW_TARGET" in
    *'$'*|*'`'*) RAW_TARGET="" ;;
  esac
  case "$RAW_TARGET" in
    /*|"") : ;;
    *) RAW_TARGET="$PWD/$RAW_TARGET" ;;
  esac
  if [ -n "$RAW_TARGET" ] && [ -d "$RAW_TARGET" ]; then
    TARGET_DIR="$RAW_TARGET"
  fi
fi

# P3.1 review gate: staged code changes require a code-reviewer subagent to
# have run this session. hooks/subagent-rails writes the marker on
# SubagentStart when agent_type matches code-reviewer/gpt-code-reviewer; we
# just check it's there. Escape hatch: CLAUDE_SUBTEAMS_SKIP_REVIEW_GATE=1.
# Fails open (no block) when session_id can't be read from stdin — we can't
# prove a review is missing if we can't identify the session, so we don't guess.
# Coarse-grained by design: "did code-reviewer run at all this session", not
# "did it review exactly these staged lines" — matches the plan's scope.
if [ "${CLAUDE_SUBTEAMS_SKIP_REVIEW_GATE:-0}" != "1" ]; then
  SID=$(printf '%s' "$INPUT" | jq -r '.session_id // empty' 2>/dev/null)
  if [ -n "$SID" ] && printf '%s' "$SID" | grep -qE '^[A-Za-z0-9._-]+$' \
     && [ "$SID" != "." ] && [ "$SID" != ".." ]; then
    STAGED=$(git -C "$TARGET_DIR" diff --cached --name-only 2>/dev/null)
    NEUTRAL_RE='^(\.gitignore|\.editorconfig|\.gitattributes|package-lock\.json|yarn\.lock|pnpm-lock\.yaml|Cargo\.lock|go\.sum|poetry\.lock|uv\.lock|composer\.lock)$|(^|/)\.DS_Store$'
    HAS_CODE=0
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      printf '%s\n' "$f" | grep -qE "$NEUTRAL_RE" && continue
      # Docs-class: prose/data text formats skip the review gate (.md always;
      # .txt/.csv/.rst/.adoc added 15.07, operator decision). Deliberately NOT
      # here: .html (site code), .yaml/.json (behavior-bearing configs — CI
      # workflows, manifests — their edits are exactly what review exists for).
      # Exception inside .txt (review finding): requirements/constraints .txt
      # are dependency MANIFESTS, not prose — they stay gated.
      if printf '%s\n' "$f" | grep -qE '\.(md|txt|csv|rst|adoc)$' \
         && ! printf '%s\n' "$f" | grep -qiE '(^|/)[^/]*(requirements|constraints)[^/]*\.txt$'; then
        continue
      fi
      HAS_CODE=1
      break
    done <<< "$STAGED"

    if [ "$HAS_CODE" -eq 1 ]; then
      MARK_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/claude-subteams/review-marks/$SID"
      if [ ! -f "$MARK_FILE" ]; then
        ERRORS="${ERRORS}${ERRORS:+\n}[subteams:pre-commit-gate] Logic changes staged, no code-reviewer run this session — run code-reviewer first, or set CLAUDE_SUBTEAMS_SKIP_REVIEW_GATE=1 to override.\n"
      fi
    fi
  fi
fi

# Size check (P9, cohesion doctrine — mirrors hooks/post-edit-check): when the
# project has a CONVENTIONS.md at the repo root, size thresholds and the
# cohesion principle live there and are enforced by review, not this hook.
# Without CONVENTIONS.md: flag staged code files past 400 lines as a
# review signal ("still one semantic unit?"), never as a verdict.
# 400 vs the 300 review threshold in prose: deliberately coarser — the hook is
# a last-resort net, review owns the 300 line; avoids mechanical noise.
# REPO_ROOT and the staged-file list are resolved against TARGET_DIR (see
# above) — the repo the commit actually targets, not necessarily cwd. Staged
# paths from `git diff --cached` are always relative to the repo root, so
# file checks below join against REPO_ROOT rather than assuming cwd == root.
REPO_ROOT=$(git -C "$TARGET_DIR" rev-parse --show-toplevel 2>/dev/null || printf '%s' "$TARGET_DIR")
LARGE_FILES=""
if [ ! -f "$REPO_ROOT/CONVENTIONS.md" ]; then
  LARGE_FILES=$(git -C "$TARGET_DIR" diff --cached --name-only 2>/dev/null | while IFS= read -r f; do
    FULL="$REPO_ROOT/$f"
    if [ -f "$FULL" ] && printf '%s\n' "$f" | grep -qE '\.(ts|js|py|go|rs|java|tsx|jsx)$'; then
      LINES=$(wc -l < "$FULL")
      if [ "$LINES" -gt 400 ]; then
        echo "  $f ($LINES lines)"
      fi
    fi
  done)
fi

if [ -n "$ERRORS" ]; then
  echo -e "$ERRORS"
  exit 2
fi

if [ -n "$LARGE_FILES" ]; then
  echo "[subteams:pre-commit-gate] Size signal — staged files past 400 lines:"
  echo "$LARGE_FILES"
  echo "Check: is each still one semantic unit (cohesion)? If yes, keep with a one-line justification; if no, split along its actual seams."
fi

exit 0
