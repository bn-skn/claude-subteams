#!/usr/bin/env bash
# subteams-browser — entry point to agent-browser 0.43.0 for ui-tester and live UI review.
#
# Finding agent-browser (plan 1.50.0, R3 and Task 2):
#   1. CLAUDE_SUBTEAMS_AGENT_BROWSER — explicit user path, taken as is;
#   2. cache ${XDG_CACHE_HOME:-$HOME/.cache}/claude-subteams/agent-browser/0.43.0/ — the lockfile install
#      (marker must name a platform candidate; version re-checked, result cached per binary mtime/size/inode);
#   3. auto-install (unless CLAUDE_SUBTEAMS_NO_AUTO_INSTALL=1): `npm ci --ignore-scripts`
#      from the plugin's deps/agent-browser/ (sha512 from the lock) into a temp dir next to the cache,
#      platform binary and `--version` checked, atomic rename into the cache; older versioned installs
#      in the cache are pruned afterwards;
#   4. only if 2-3 are unavailable or disabled: `agent-browser` on PATH whose `--version` is exactly
#      0.43.0, with a note on stderr (it is not the lockfile install).
# From the cache the platform binary is run directly: the package's JS launcher rewrites the install
# on first run (spike 0.3). Paths come from readlink -f "$0": a bin script gets no CLAUDE_PLUGIN_ROOT,
# and CLAUDE_PLUGIN_DATA may belong to another plugin (spike 0.2).
#
# Browser — only system Chrome/Chromium or one downloaded by an explicit `subteams-browser setup`
# (Playwright's Chromium needs --no-sandbox here — refused, spike 0.4).
# Every browser command needs `--session <name>`. Commands and options pass an allowlist (see the
# argument policy below); allowed arguments are passed through verbatim.
# `screenshot` writes a `shot` receipt after success (§5.3). The environment is never printed.
#
# Environment passed to agent-browser: every AGENT_BROWSER_* variable is dropped except
#   AGENT_BROWSER_EXECUTABLE_PATH — the user's browser choice (refused if it is Playwright's Chromium);
# and the wrapper sets
#   AGENT_BROWSER_CONFIG     — an empty `{}` config in the cache: disables discovery of
#                              ~/.agent-browser/config.json and ./agent-browser.json (profile, args,
#                              extensions, plugins, cdp ... from there never apply);
#   AGENT_BROWSER_SKILLS_DIR — skill-data of the cache install (when running from the cache).
#
# Exit codes: 2 — invalid or denied call; 127 — no agent-browser / browser / install failed;
# otherwise — agent-browser's code.
set -u
CALLER_UMASK=$(umask)
umask 077   # for what the wrapper itself creates; agent-browser runs with the caller's umask

AB_VERSION=0.43.0
INSTALL_TIMEOUT=90    # s, for npm ci; below the Bash tool's 120 s so our own failure is reported first
LOCK_WAIT=100         # s, waiting for another install
LOCK_STALE_AGE=180    # s, after this a lock is stale even if its pid is alive

say() { printf 'subteams-browser: %s\n' "$*" >&2; }
die() { local rc="$1"; shift; say "$*"; exit "$rc"; }

# --- paths ------------------------------------------------------------------
resolve_self() { # readlink -f; fallback for old macOS without -f
  local p="$0" d r
  if r=$(readlink -f -- "$p" 2>/dev/null) && [ -n "$r" ]; then printf '%s' "$r"; return; fi
  while [ -L "$p" ]; do
    d=$(cd -P -- "$(dirname -- "$p")" && pwd) || return 1
    p=$(readlink -- "$p") || return 1
    case $p in /*) ;; *) p="$d/$p" ;; esac
  done
  d=$(cd -P -- "$(dirname -- "$p")" && pwd) || return 1
  printf '%s/%s' "$d" "$(basename -- "$p")"
}

SELF=$(resolve_self) || die 127 "cannot resolve own path"
PLUGIN_ROOT=$(dirname -- "$(dirname -- "$SELF")")
DEPS="$PLUGIN_ROOT/deps/agent-browser"
# XDG spec: a relative XDG_CACHE_HOME is invalid and must be ignored
case "${XDG_CACHE_HOME:-}" in /*) CACHE_ROOT="$XDG_CACHE_HOME" ;; *) CACHE_ROOT="$HOME/.cache" ;; esac
CACHE_BASE="$CACHE_ROOT/claude-subteams"
AB_DIR="$CACHE_BASE/agent-browser"
INSTALL="$AB_DIR/$AB_VERSION"
LOCK="$AB_DIR/$AB_VERSION.lock"

AB_BIN=""; AB_SKILLS=""
TMP_INSTALL=""; LOCK_HELD=0; STAMP=""
# shellcheck disable=SC2317  # called from trap
cleanup() {
  [ -n "$TMP_INSTALL" ] && rm -rf -- "$TMP_INSTALL"
  [ "$LOCK_HELD" = 1 ] && rm -rf -- "$LOCK"
  [ -n "$STAMP" ] && rm -f -- "$STAMP"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# --- environment ------------------------------------------------------------
scrub_env() { # every AGENT_BROWSER_* except the user's browser path (see the header)
  local v
  for v in $(compgen -e); do
    case "$v" in
      AGENT_BROWSER_EXECUTABLE_PATH) ;;
      AGENT_BROWSER_*) unset "$v" ;;
    esac
  done
}
scrub_env

# An explicit config file replaces default discovery (agent-browser 0.43.0 --help, verified): an empty
# one keeps the user-level and project-level configs out. Rewritten if missing, a symlink or not `{}`.
NEUTRAL_CONFIG="$AB_DIR/neutral-config.json"
ensure_neutral_config() {
  local tmp
  if [ -f "$NEUTRAL_CONFIG" ] && [ ! -L "$NEUTRAL_CONFIG" ] && [ "$(cat -- "$NEUTRAL_CONFIG" 2>/dev/null)" = '{}' ]; then
    return 0
  fi
  mkdir -p -- "$AB_DIR" 2>/dev/null || return 1
  tmp=$(mktemp "$AB_DIR/.neutral.XXXXXX" 2>/dev/null) || return 1
  if printf '{}\n' > "$tmp" && mv -f -- "$tmp" "$NEUTRAL_CONFIG"; then return 0; fi
  rm -f -- "$tmp"; return 1
}
ensure_neutral_config || die 127 "cannot create $NEUTRAL_CONFIG (an empty config that keeps ~/.agent-browser/config.json out)"
export AGENT_BROWSER_CONFIG="$NEUTRAL_CONFIG"

# AGENT_BROWSER_EXECUTABLE_PATH is how the user picks a browser — honoured, except Playwright's Chromium
if [ -n "${AGENT_BROWSER_EXECUTABLE_PATH:-}" ]; then
  exe_real=$(readlink -f -- "$AGENT_BROWSER_EXECUTABLE_PATH" 2>/dev/null) || exe_real=""
  case "$AGENT_BROWSER_EXECUTABLE_PATH:$exe_real" in
    */ms-playwright/*) die 2 "AGENT_BROWSER_EXECUTABLE_PATH points to Playwright's Chromium, which needs --no-sandbox here; use system Chrome or \`subteams-browser setup\`" ;;
  esac
fi

# --- version and platform binary ---------------------------------------------
version_ok() { # <executable>
  local out
  out=$("$1" --version 2>/dev/null) || return 1
  [ "$out" = "agent-browser $AB_VERSION" ]
}

file_sig() { # <file> -> "mtime size inode" (GNU stat, then BSD stat)
  stat -c '%Y %s %i' -- "$1" 2>/dev/null || stat -f '%m %z %i' -- "$1" 2>/dev/null
}

write_verified() { # <install dir> <rel>: record that this exact binary passed version_ok
  local sig
  sig=$(file_sig "$1/$2") && [ -n "$sig" ] || return 0
  { printf '%s %s\n' "$AB_VERSION" "$sig" > "$1/.subteams-verified.$$" \
      && mv -f -- "$1/.subteams-verified.$$" "$1/.subteams-verified"; } 2>/dev/null
  rm -f -- "$1/.subteams-verified.$$" 2>/dev/null
  return 0
}

verified_cached() { # <install dir> <rel>: version check, skipped while the binary's signature is unchanged
  local sig got
  sig=$(file_sig "$1/$2") || sig=""
  if [ -n "$sig" ] && got=$(cat -- "$1/.subteams-verified" 2>/dev/null) && [ "$got" = "$AB_VERSION $sig" ]; then
    return 0
  fi
  version_ok "$1/$2" || return 1
  write_verified "$1" "$2"
}

# Candidates (paths relative to the install dir) in order of preference for this machine.
platform_candidates() {
  local os arch libc other
  case "$(uname -s)" in Linux) os=linux ;; Darwin) os=darwin ;; *) return 0 ;; esac
  case "$(uname -m)" in x86_64|amd64) arch=x64 ;; aarch64|arm64) arch=arm64 ;; *) return 0 ;; esac
  if [ "$os" = darwin ]; then
    printf '%s\n' "node_modules/@agent-browser/cli-darwin-$arch/bin/agent-browser" \
                  "node_modules/agent-browser/bin/agent-browser-darwin-$arch"
    return 0
  fi
  libc=gnu; other=musl
  if ls /lib/ld-musl-*.so.1 >/dev/null 2>&1; then libc=musl; other=gnu; fi
  for l in "$libc" "$other"; do
    printf '%s\n' "node_modules/@agent-browser/cli-linux-$arch-$l/bin/agent-browser"
    if [ "$l" = musl ]; then printf '%s\n' "node_modules/agent-browser/bin/agent-browser-linux-musl-$arch"
    else printf '%s\n' "node_modules/agent-browser/bin/agent-browser-linux-$arch"; fi
  done
}

pick_platform_binary() { # <install dir> -> relative path of the first working binary
  local dir="$1" rel first=""
  while IFS= read -r rel; do
    [ -n "$first" ] || first="$rel"
    if ! { [ -f "$dir/$rel" ] && [ -x "$dir/$rel" ]; }; then continue; fi
    if version_ok "$dir/$rel"; then
      # npm skips an optional dependency that fails (e.g. integrity) and goes on: say so once
      case "$first|$rel" in *-gnu/*'|'*musl*)
        say "warning: the glibc build of agent-browser is missing or failed its check (see $AB_DIR/install.log); using the musl build" ;;
      esac
      printf '%s' "$rel"; return 0
    fi
  done < <(platform_candidates)
  return 1
}

cache_valid() { # the marker is written only after the binary and version were checked
  local rel cand known=0
  [ -f "$INSTALL/.subteams-bin" ] || return 1
  rel=$(cat -- "$INSTALL/.subteams-bin" 2>/dev/null) || return 1
  while IFS= read -r cand; do [ "$rel" = "$cand" ] && known=1; done < <(platform_candidates)
  [ "$known" = 1 ] || return 1
  [ -f "$INSTALL/$rel" ] && [ -x "$INSTALL/$rel" ] || return 1
  verified_cached "$INSTALL" "$rel" || return 1
  AB_BIN="$INSTALL/$rel"
  AB_SKILLS="$INSTALL/node_modules/agent-browser/skill-data"
}

# --- mkdir lock (no flock on macOS) -------------------------------------------
lock_stale() {
  local pid="" ts="" now
  if [ -f "$LOCK/owner" ]; then
    read -r pid ts < "$LOCK/owner" 2>/dev/null || true
    case "$pid" in ''|*[!0-9]*) return 0 ;; esac
    kill -0 "$pid" 2>/dev/null || return 0
    case "$ts" in ''|*[!0-9]*) return 0 ;; esac
    now=$(date +%s)
    [ $((now - ts)) -gt "$LOCK_STALE_AGE" ]
    return
  fi
  # dir exists but no owner yet: stale only if old
  [ -n "$(find "$LOCK" -maxdepth 0 -mmin +3 2>/dev/null)" ]
}

acquire_lock() {
  local waited=0 aside
  while ! mkdir -- "$LOCK" 2>/dev/null; do
    [ -d "$LOCK" ] || die 127 "cannot create lock $LOCK"
    if lock_stale; then
      aside="$LOCK.stale.$$"
      # rename is atomic: of two waiters only one takes the stale lock
      mv -- "$LOCK" "$aside" 2>/dev/null && rm -rf -- "$aside"
      continue
    fi
    [ "$waited" -ge "$LOCK_WAIT" ] && die 127 "another agent-browser install has run longer than ${LOCK_WAIT} s (lock $LOCK)"
    sleep 1; waited=$((waited + 1))
  done
  LOCK_HELD=1
  printf '%s %s\n' "$$" "$(date +%s)" > "$LOCK/owner"
}

release_lock() { [ "$LOCK_HELD" = 1 ] && rm -rf -- "$LOCK"; LOCK_HELD=0; }

# --- auto-install -----------------------------------------------------------
install_fail() {
  [ -n "$TMP_INSTALL" ] && rm -rf -- "$TMP_INSTALL"
  TMP_INSTALL=""
  release_lock
  die 127 "agent-browser $AB_VERSION install failed: $*"
}

auto_install() {
  local log pid rc waited rel
  command -v npm >/dev/null 2>&1 || die 127 "agent-browser $AB_VERSION not found, and auto-install needs npm (Node.js)"
  command -v node >/dev/null 2>&1 || die 127 "agent-browser $AB_VERSION not found, and auto-install needs Node.js"
  if ! { [ -f "$DEPS/package.json" ] && [ -f "$DEPS/package-lock.json" ]; }; then
    die 127 "pinned dependency tree missing: $DEPS"
  fi
  mkdir -p -- "$AB_DIR" || die 127 "cannot create cache dir $AB_DIR"

  acquire_lock
  if cache_valid; then release_lock; return 0; fi   # a parallel run installed it
  if [ -e "$INSTALL" ]; then                         # broken install (no valid marker)
    mv -- "$INSTALL" "$AB_DIR/.broken.$$" 2>/dev/null && rm -rf -- "$AB_DIR/.broken.$$"
    [ -e "$INSTALL" ] && install_fail "cannot remove broken install $INSTALL"
  fi

  # leftovers of interrupted installs (wrapper killed mid npm ci); an active install belongs to the lock owner only
  find "$AB_DIR" -maxdepth 1 -type d -name '.install-*' -mmin +5 -exec rm -rf {} + 2>/dev/null
  printf 'subteams: installing agent-browser %s into %s (one time)\n' "$AB_VERSION" "$INSTALL" >&2
  TMP_INSTALL=$(mktemp -d "$AB_DIR/.install-XXXXXX") || install_fail "cannot create temp dir"
  cp -- "$DEPS/package.json" "$DEPS/package-lock.json" "$TMP_INSTALL/" || install_fail "cannot copy the lock file"
  log="$AB_DIR/install.log"

  (cd -- "$TMP_INSTALL" && exec npm ci --ignore-scripts --no-fund --no-audit) >"$log" 2>&1 &
  pid=$!
  waited=0
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$waited" -ge "$INSTALL_TIMEOUT" ]; then
      pkill -TERM -P "$pid" 2>/dev/null; kill -TERM "$pid" 2>/dev/null
      sleep 2
      pkill -KILL -P "$pid" 2>/dev/null; kill -KILL "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null
      install_fail "npm ci did not finish within ${INSTALL_TIMEOUT} s; log: $log"
    fi
    sleep 1; waited=$((waited + 1))
  done
  wait "$pid"; rc=$?
  [ "$rc" -eq 0 ] || install_fail "npm ci exited with code $rc; log: $log"

  rel=$(pick_platform_binary "$TMP_INSTALL") \
    || install_fail "no platform binary for $(uname -s)/$(uname -m), or its version is not $AB_VERSION; log: $log"
  printf '%s\n' "$rel" > "$TMP_INSTALL/.subteams-bin" || install_fail "cannot write install marker"
  write_verified "$TMP_INSTALL" "$rel"   # rename keeps mtime/size/inode, so the cached check stays valid

  # rename(2): atomic and fails if the target exists (mv gives no such guarantee)
  if ! node -e 'require("fs").renameSync(process.argv[1], process.argv[2])' "$TMP_INSTALL" "$INSTALL" 2>/dev/null; then
    cache_valid && { rm -rf -- "$TMP_INSTALL"; TMP_INSTALL=""; release_lock; return 0; }
    install_fail "cannot move the install into $INSTALL"
  fi
  TMP_INSTALL=""
  prune_old_installs
  release_lock
  cache_valid || die 127 "install in $INSTALL failed verification"
}

# Older pinned versions left by earlier plugin releases: real directories only (find -type d does not
# follow symlinks), names exactly N.N.N, directly inside the cache dir, not this version, no lock dir
# (an install of that version in progress).
prune_old_installs() {
  local d n
  while IFS= read -r d; do
    n=${d##*/}
    [[ $n =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || continue
    if [ "$n" = "$AB_VERSION" ] || [ -e "$AB_DIR/$n.lock" ]; then continue; fi
    rm -rf -- "${AB_DIR:?}/$n"
  done < <(find "$AB_DIR" -mindepth 1 -maxdepth 1 -type d -name '[0-9]*.[0-9]*.[0-9]*' 2>/dev/null)
  return 0
}

# Negative cache of a failed auto-install: for FAIL_TTL seconds every call skips `npm ci` (up to
# INSTALL_TIMEOUT each) and goes straight to the PATH fallback. Keyed to the version + lockfile hash,
# so a plugin update retries at once; a symlink or another key is ignored (and replaced on the next
# failure). A successful install — e.g. an explicit `subteams-browser setup` — removes it.
FAIL_STAMP="$AB_DIR/$AB_VERSION.install-failed"
FAIL_TTL=600
FAIL_HINT=""
install_key() { { printf '%s\n' "$AB_VERSION"; cat -- "$DEPS/package-lock.json" 2>/dev/null; } | cksum | tr -s ' ' '-'; }
fail_fresh() { # -> 0 and FAIL_HINT set when a matching stamp is younger than FAIL_TTL
  local m now age
  [ -f "$FAIL_STAMP" ] && [ ! -L "$FAIL_STAMP" ] || return 1
  [ "$(cat -- "$FAIL_STAMP" 2>/dev/null)" = "$(install_key)" ] || return 1
  m=$(file_sig "$FAIL_STAMP") || return 1
  m=${m%% *}; now=$(date +%s)
  case "$m" in ''|*[!0-9]*) return 1 ;; esac
  age=$((now - m))
  [ "$age" -ge 0 ] && [ "$age" -lt "$FAIL_TTL" ] || return 1
  FAIL_HINT="install failed $((age / 60)) min ago; retry after $(((FAIL_TTL - age + 59) / 60)) min or delete $FAIL_STAMP"
}
fail_record() {
  local tmp
  mkdir -p -- "$AB_DIR" 2>/dev/null || return 0
  tmp=$(mktemp "$AB_DIR/.failed.XXXXXX" 2>/dev/null) || return 0
  if install_key > "$tmp" && mv -f -- "$tmp" "$FAIL_STAMP"; then return 0; fi
  rm -f -- "$tmp"; return 0
}

resolve_agent_browser() {
  local sys
  if [ -n "${CLAUDE_SUBTEAMS_AGENT_BROWSER:-}" ]; then
    if ! { [ -f "$CLAUDE_SUBTEAMS_AGENT_BROWSER" ] && [ -x "$CLAUDE_SUBTEAMS_AGENT_BROWSER" ]; }; then
      die 127 "CLAUDE_SUBTEAMS_AGENT_BROWSER does not point to an executable file"
    fi
    AB_BIN="$CLAUDE_SUBTEAMS_AGENT_BROWSER"; return 0
  fi
  cache_valid && return 0
  local rc=0
  if [ "${CLAUDE_SUBTEAMS_NO_AUTO_INSTALL:-}" = 1 ]; then rc=1
  elif [ "${1:-}" != retry ] && fail_fresh; then rc=127
  else
    # own EXIT/INT/TERM traps: a die inside still removes the temp dir and releases the lock
    ( trap cleanup EXIT; trap 'exit 130' INT TERM; auto_install ) || rc=$?
    [ "$rc" = 130 ] && exit 130
    if [ "$rc" = 0 ] && cache_valid; then rm -f -- "$FAIL_STAMP"; return 0; fi
    fail_record
  fi
  if sys=$(command -v agent-browser 2>/dev/null) && [ -n "$sys" ] && version_ok "$sys"; then
    say "note: using agent-browser $AB_VERSION from PATH ($sys): the plugin's lockfile install is unavailable${FAIL_HINT:+ ($FAIL_HINT)}"
    AB_BIN="$sys"; return 0
  fi
  [ "${CLAUDE_SUBTEAMS_NO_AUTO_INSTALL:-}" = 1 ] \
    && die 127 "agent-browser $AB_VERSION not found, auto-install is off (CLAUDE_SUBTEAMS_NO_AUTO_INSTALL=1). Live UI review not performed"
  [ -n "$FAIL_HINT" ] && die 127 "agent-browser $AB_VERSION not available: $FAIL_HINT. Live UI review not performed"
  exit "${rc:-127}"
}

# --- browser ----------------------------------------------------------------
have_browser() {
  local n a
  if [ -n "${AGENT_BROWSER_EXECUTABLE_PATH:-}" ] && [ -x "$AGENT_BROWSER_EXECUTABLE_PATH" ]; then return 0; fi
  for n in google-chrome google-chrome-stable chromium chromium-browser; do
    command -v "$n" >/dev/null 2>&1 && return 0
  done
  if [ "$(uname -s)" = Darwin ]; then
    for a in "/Applications/Google Chrome.app" "/Applications/Chromium.app" \
             "$HOME/Applications/Google Chrome.app" "$HOME/Applications/Chromium.app"; do
      [ -d "$a" ] && return 0
    done
  fi
  # Chrome for Testing from `subteams-browser setup` (agent-browser install): ~/.agent-browser/browsers
  [ -n "$(ls -A "$HOME/.agent-browser/browsers" 2>/dev/null)" ]
}

# --- shot receipt (§5.3) ----------------------------------------------------
LIB="$PLUGIN_ROOT/scripts/lib-testclass.sh"

json_str() { # JSON string escaping; control characters other than \n\t\r — refused
  local s="$1"
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/\\r}
  case "$s" in *[[:cntrl:]]*) return 1 ;; esac
  printf '"%s"' "$s"
}

no_receipt() { say "warning: screenshot taken, but no shot receipt written: $*"; return 0; }

# <absolute path> <session>. Written with the shared tc_receipt_write: the repo store plus a line in
# the global _recent.log, which is how subagent-rails finds evidence left in another repository.
# Outside a git repo — silently nothing; any other failure — a warning, never a failed screenshot.
write_shot_receipt() {
  local file="$1" session="$2" size ts jpath jsess top jroot
  git rev-parse --git-dir >/dev/null 2>&1 || return 0
  [ -f "$LIB" ] || { no_receipt "cannot load $LIB"; return 0; }
  size=$(wc -c < "$file" | tr -d ' ') || size=""
  [ -n "$size" ] || { no_receipt "cannot read $file"; return 0; }
  ts=$(date +%s)
  if ! { jpath=$(json_str "$file") && jsess=$(json_str "$session"); }; then
    no_receipt "path or session contains control characters"; return 0
  fi
  # root = the working tree where the screenshot was taken (worktree): subagent-rails picks the snapshot by it
  top=$(git rev-parse --show-toplevel 2>/dev/null) && jroot=$(json_str "$top") || jroot=null
  # In a subshell without `set -u`: whatever the lib does (an unset variable, exit) cannot change
  # agent-browser's exit code. The lib reads XDG_CACHE_HOME raw: hand it the validated cache root.
  ( set +u
    # shellcheck source=../scripts/lib-testclass.sh disable=SC1091
    . "$LIB" 2>/dev/null || { no_receipt "cannot load $LIB"; exit 0; }
    XDG_CACHE_HOME="$CACHE_ROOT" tc_receipt_write "$PWD" \
      "{\"type\":\"shot\",\"kind\":\"shot\",\"path\":$jpath,\"size\":$size,\"session\":$jsess,\"ts\":$ts,\"root\":$jroot}" >/dev/null \
      || no_receipt "${TC_ERR:-tc_receipt_write failed}"
  ) || no_receipt "the receipt step exited with an error"
  return 0
}

abs_path() { # <path> -> absolute, directory canonicalized
  local d b
  d=$(cd -P -- "$(dirname -- "$1")" 2>/dev/null && pwd) || return 1
  b=$(basename -- "$1")
  printf '%s/%s' "$d" "$b"
}

# --- argument policy --------------------------------------------------------
# agent-browser 0.43.0 strips its global options anywhere in argv — also between and after the
# operands (`fill '#f' x --json` takes --json as the flag, verified) — and takes the first remaining
# token as the command (an unknown option becomes the "command"); `--opt=value` is not parsed. A global
# value option consumes the next token even if it starts with a dash; a boolean one consumes a following
# true/false. Global parsing stops at `--`: the rest reaches the command as plain operands (verified live
# with `<cmd> ... -- --json` for every allowed command except record). Hence every dash token before
# `--` must be an allowed global option or an allowed option of the command; text that starts with a
# dash goes after `--` (`fill <sel> -- --text`), as the agent-browser docs say.
# Arity below was probed against 0.43.0 with `session` as the stand-in command.
VALUE_OPTS=" --session --user-agent --color-scheme --screenshot-dir --screenshot-quality --screenshot-format --max-output --idle-timeout --input-mode --allowed-domains "
BOOL_OPTS=" --json --annotate --debug --content-boundaries --ignore-https-errors --no-auto-dialog --pin-tab --no-pin-tab --relaunch --no-webmcp --hide-scrollbars "
# Named for a clearer refusal (any option not allowed is refused anyway): the user's real
# Chrome/profile/saved state, code loading, file access, another browser binary or engine,
# cloud/plugin providers, arbitrary download paths.
DENY_OPTS=" --profile --auto-connect --cdp --cdp-headers --args --config --extension --init-script --init-scripts --allow-file-access --executable-path --user-data-dir --headed --state --restore --restore-save --restore-check-url --restore-check-text --restore-check-fn --session-name -p --provider --engine --ca-cert --download-path "
COMMANDS=" open snapshot click dblclick fill type press hover focus select check uncheck scroll scrollintoview wait get is find screenshot eval console errors set tab close back forward reload record skills session "

cmd_opts() { # <command> -> its own options (agent-browser <command> --help, 0.43.0); --help/-h for all
  local o=""
  case "$1" in
    snapshot) o="-i --interactive -u --urls -c --compact -d --depth -s --selector --delta --full" ;;
    click) o="--new-tab --human" ;;
    type) o="--clear --delay" ;;
    scroll) o="-s --selector" ;;
    wait) o="--url --load --fn --text --timeout" ;;   # --state: the wait exception above
    find) o="--name --exact" ;;
    screenshot) o="--full -f --if-changed --threshold" ;;
    eval) o="-b --base64 --stdin" ;;
    console|errors) o="--clear" ;;
    tab) o="--label" ;;
    record) o="--fps --cursor --contact-sheet --contact-sheet-threshold" ;;
    skills) o="--full --ref --all" ;;
  esac
  printf ' %s--help -h ' "${o:+$o }"
}

inlist() { # <word> <" list ">
  case "$1" in ''|*[[:space:]]*) return 1 ;; esac
  case "$2" in *" $1 "*) return 0 ;; esac
  return 1
}

if [ "${1:-}" = setup ]; then
  shift
  case "$*" in ''|--with-deps) ;; *) die 2 "setup takes no arguments other than --with-deps" ;; esac
  resolve_agent_browser retry   # explicit: ignore the failed-install stamp; success removes it
  [ -n "$AB_SKILLS" ] && export AGENT_BROWSER_SKILLS_DIR="$AB_SKILLS"
  umask "$CALLER_UMASK"
  exec "$AB_BIN" install "$@"
fi

args=("$@")
SESSION=""; SESSION_LATE=0; CMD=""; CMD_IDX=-1; SUB=""
exempt=0
if [ "$#" -eq 0 ]; then exempt=1
elif [ "$#" -eq 1 ]; then case "$1" in --version|-V|--help|-h) exempt=1 ;; esac
fi

if [ "$exempt" = 0 ]; then
  END=${#args[@]}   # index of the first `--` after the command (global parsing stops there)
  i=0
  while [ "$i" -lt "${#args[@]}" ]; do
    a="${args[$i]}"
    if [ "$a" = -- ] && [ "$CMD_IDX" -ge 0 ]; then END=$i; break; fi
    if inlist "$a" "$VALUE_OPTS"; then
      if [ "$a" = --session ]; then
        # after the command agent-browser may never see it (an unlisted value option swallows it)
        if [ "$CMD_IDX" -lt 0 ]; then SESSION="${args[$((i + 1))]:-}"; else SESSION_LATE=1; fi
      fi
      i=$((i + 2)); continue
    fi
    if inlist "$a" "$BOOL_OPTS"; then
      case "${args[$((i + 1))]:-}" in true|false) i=$((i + 2)) ;; *) i=$((i + 1)) ;; esac
      continue
    fi
    if [ "$CMD_IDX" -lt 0 ]; then CMD="$a"; CMD_IDX=$i
    elif [ -z "$SUB" ]; then SUB="$a"; fi
    i=$((i + 1))
  done

  # 1) named dangerous options anywhere before `--` (values of allowed options too: fail closed)
  for ((k = 0; k < END; k++)); do
    a="${args[$k]}"
    if inlist "${a%%=*}" "$DENY_OPTS"; then
      # after `wait`, --state is the selector state (visible/hidden/...), not the auth-state file;
      # placed before `wait` it is itself parsed as the command, so CMD is not wait there
      if [ "$a" = --state ] && [ "$CMD" = wait ]; then
        case "${args[$((k + 1))]:-}" in visible|hidden|attached|detached) continue ;; esac
      fi
      case "${a%%=*}" in
        --executable-path) die 2 "--executable-path is not allowed: the user picks the browser via AGENT_BROWSER_EXECUTABLE_PATH (not Playwright's Chromium — it needs --no-sandbox)" ;;
        --headed) die 2 "--headed is not allowed: the browser runs headless" ;;
      esac
      die 2 "option ${a%%=*} is not allowed: it reaches the real browser profile, files, credentials or the browser binary"
    fi
  done

  case "$CMD" in
    install) die 2 "install is not allowed through the wrapper: use \`subteams-browser setup\`" ;;
    upgrade) die 2 "upgrade is not allowed: agent-browser $AB_VERSION is pinned by the plugin and changes only with its release" ;;
    -*) die 2 "option $CMD is not allowed before the command" ;;
    '') die 2 "no command given: subteams-browser --session <name> <command> ..." ;;
  esac
  [ "$SESSION_LATE" = 0 ] || die 2 "--session must come before the command: subteams-browser --session <name> <command> ..."
  inlist "$CMD" "$COMMANDS" \
    || die 2 "command '$CMD' is not allowed. Allowed:${COMMANDS% } (set viewport|device|media, skills get|list, session list, record start|stop), --version, --help, setup"
  bad_sub() { die 2 "'$CMD ${SUB:-}' is not allowed; allowed: $CMD $1"; }
  case "$CMD" in
    set) case "$SUB" in viewport|device|media) ;; *) bad_sub "viewport|device|media" ;; esac ;;
    skills) case "$SUB" in ''|list|get) ;; *) bad_sub "get|list" ;; esac ;;
    session) case "$SUB" in list) ;; *) bad_sub "list" ;; esac ;;
    record) case "$SUB" in start|stop) ;; *) bad_sub "start|stop" ;; esac ;;
  esac
  # 2) every other dash token before `--` (after the command) is an allowed option of this command;
  #    global options are skipped with their value, exactly as agent-browser does
  copts=$(cmd_opts "$CMD")
  i=$((CMD_IDX + 1))
  while [ "$i" -lt "$END" ]; do
    a="${args[$i]}"
    if inlist "$a" "$VALUE_OPTS"; then i=$((i + 2)); continue; fi
    if inlist "$a" "$BOOL_OPTS"; then
      case "${args[$((i + 1))]:-}" in true|false) i=$((i + 2)) ;; *) i=$((i + 1)) ;; esac
      continue
    fi
    case "$a" in
      -|-[0-9]*) ;;   # a lone dash or a negative number is an operand
      -*)
        case "$CMD:$a" in
          close:--all|wait:--download|wait:--state) ;;   # refused below / checked in 1)
          *) inlist "$a" "$copts" \
               || die 2 "option $a is not allowed with '$CMD' (allowed:${copts% }); text that starts with a dash goes after --" ;;
        esac ;;
    esac
    i=$((i + 1))
  done
  # also after `--`: the command itself may still read these
  for ((k = CMD_IDX + 1; k < ${#args[@]}; k++)); do
    case "$CMD:${args[$k]}" in
      close:--all) die 2 "close --all is not allowed: close only your own session (subteams-browser --session <name> close)" ;;
      wait:--download) die 2 "wait --download is not allowed: it writes a page-supplied file to an arbitrary path" ;;
    esac
  done

  # skills and session list touch no browser session: no --session and no browser needed
  case "$CMD" in skills|session) ;; *)
    case "$SESSION" in
      ''|-*) die 2 "own session required: subteams-browser --session <name> <command> ... (the shared default session is not used)" ;;
    esac
    have_browser || die 127 "no browser found: install Chrome or run \`subteams-browser setup\` (~150 MB). Live UI review not performed" ;;
  esac
fi

resolve_agent_browser
[ -n "$AB_SKILLS" ] && export AGENT_BROWSER_SKILLS_DIR="$AB_SKILLS"

if [ "$CMD" != screenshot ]; then
  umask "$CALLER_UMASK"
  exec "$AB_BIN" "$@"
fi

# screenshot: run as a child so a receipt can be written after success
STAMP=$(mktemp "${TMPDIR:-/tmp}/subteams-shot-XXXXXX") || STAMP=""
(umask "$CALLER_UMASK"; exec "$AB_BIN" "$@")
rc=$?
if [ "$rc" -eq 0 ] && [ -n "$STAMP" ]; then
  # path = the last argument after screenshot that became a fresh non-empty file (a name may start
  # with a dash, e.g. after `--`; option words are never fresh files, `--` itself is skipped)
  shot=""
  j=$((CMD_IDX + 1))
  while [ "$j" -lt "${#args[@]}" ]; do
    a="${args[$j]}"
    if [ "$a" != -- ] && [ -f "$a" ] && [ -s "$a" ] && ! [ "$STAMP" -nt "$a" ]; then shot="$a"; fi
    j=$((j + 1))
  done
  if [ -n "$shot" ] && shot_abs=$(abs_path "$shot"); then
    write_shot_receipt "$shot_abs" "$SESSION"
  elif git rev-parse --git-dir >/dev/null 2>&1; then
    # agent-browser resolves a relative path from where the session was opened, not from the cwd
    say "screenshot taken, but no shot receipt written: pass an absolute path to the file"
  fi
fi
[ -n "$STAMP" ] && rm -f -- "$STAMP"
STAMP=""
exit "$rc"
