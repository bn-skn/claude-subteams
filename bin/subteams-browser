#!/usr/bin/env bash
# subteams-browser — точка входа в agent-browser 0.43.0 для ui-tester и осмотра интерфейса.
#
# Поиск agent-browser (план 1.50.0, R3 и Задача 2):
#   1. CLAUDE_SUBTEAMS_AGENT_BROWSER — явный путь пользователя, берётся как есть;
#   2. кэш ${XDG_CACHE_HOME:-$HOME/.cache}/claude-subteams/agent-browser/0.43.0/;
#   3. системный `agent-browser`, только если `--version` ровно 0.43.0;
#   4. автоустановка (если не CLAUDE_SUBTEAMS_NO_AUTO_INSTALL=1): `npm ci --ignore-scripts`
#      из deps/agent-browser/ плагина (sha512 из lock) во временный каталог рядом с кэшем,
#      проверка платформенного бинаря и `--version`, атомарное переименование в кэш.
# Из кэша запускается платформенный бинарь напрямую: JS-лаунчер пакета при первом запуске
# переписывает установку (спайк 0.3). Пути — от readlink -f "$0": bin-скрипт не получает
# CLAUDE_PLUGIN_ROOT, а CLAUDE_PLUGIN_DATA может принадлежать чужому плагину (спайк 0.2).
#
# Браузер — только системный Chrome/Chromium или скачанный явным `subteams-browser setup`
# (Chromium из кэша Playwright требует --no-sandbox — не используется, спайк 0.4).
# Каждая команда браузера требует `--session <имя>`; аргументы передаются как есть.
# `screenshot` после успеха пишет квитанцию `shot` (§5.3). Окружение не печатается.
#
# Коды выхода: 2 — неверный вызов (нет --session); 127 — нет agent-browser / браузера /
# установка не удалась; иначе — код agent-browser.
set -u

AB_VERSION=0.43.0
INSTALL_TIMEOUT=120   # с, на npm ci
LOCK_WAIT=200         # с, ожидание чужой установки
LOCK_STALE_AGE=180    # с, после этого блокировка считается протухшей даже при живом pid

say() { printf 'subteams-browser: %s\n' "$*" >&2; }
die() { local rc="$1"; shift; say "$*"; exit "$rc"; }

# --- пути -------------------------------------------------------------------
resolve_self() { # readlink -f; запасной путь для старого macOS без -f
  local p="$0" d r
  if r=$(readlink -f -- "$p" 2>/dev/null) && [ -n "$r" ]; then printf '%s' "$r"; return; fi
  while [ -L "$p" ]; do
    d=$(cd -P -- "$(dirname -- "$p")" && pwd) || return 1
    p=$(readlink -- "$p") || return 1
    case $p in /*) ;; *) p="$d/$p" ;; esac
  done
  d=$(cd -P -- "$(dirname -- "$p")" && pwd) || return 1
  printf '%s/%s' "$d" "$(basename -- "$p")"
}

SELF=$(resolve_self) || die 127 "не удалось определить путь к себе"
PLUGIN_ROOT=$(dirname -- "$(dirname -- "$SELF")")
DEPS="$PLUGIN_ROOT/deps/agent-browser"
CACHE_BASE="${XDG_CACHE_HOME:-$HOME/.cache}/claude-subteams"
AB_DIR="$CACHE_BASE/agent-browser"
INSTALL="$AB_DIR/$AB_VERSION"
LOCK="$AB_DIR/$AB_VERSION.lock"

AB_BIN=""; AB_SKILLS=""
TMP_INSTALL=""; LOCK_HELD=0
# shellcheck disable=SC2317  # вызывается из trap
cleanup() {
  [ -n "$TMP_INSTALL" ] && rm -rf -- "$TMP_INSTALL"
  [ "$LOCK_HELD" = 1 ] && rm -rf -- "$LOCK"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# --- версия и платформенный бинарь -------------------------------------------
version_ok() { # <исполняемый файл>
  local out
  out=$("$1" --version 2>/dev/null) || return 1
  [ "$out" = "agent-browser $AB_VERSION" ]
}

# Кандидаты (пути относительно каталога установки) в порядке предпочтения для этой машины.
platform_candidates() {
  local os arch libc other
  case "$(uname -s)" in Linux) os=linux ;; Darwin) os=darwin ;; *) return 0 ;; esac
  case "$(uname -m)" in x86_64|amd64) arch=x64 ;; aarch64|arm64) arch=arm64 ;; *) return 0 ;; esac
  if [ "$os" = darwin ]; then
    printf '%s\n' "node_modules/@agent-browser/cli-darwin-$arch/bin/agent-browser" \
                  "node_modules/agent-browser/bin/agent-browser-darwin-$arch"
    return 0
  fi
  libc=gnu; other=musl
  if ls /lib/ld-musl-*.so.1 >/dev/null 2>&1; then libc=musl; other=gnu; fi
  for l in "$libc" "$other"; do
    printf '%s\n' "node_modules/@agent-browser/cli-linux-$arch-$l/bin/agent-browser"
    if [ "$l" = musl ]; then printf '%s\n' "node_modules/agent-browser/bin/agent-browser-linux-musl-$arch"
    else printf '%s\n' "node_modules/agent-browser/bin/agent-browser-linux-$arch"; fi
  done
}

pick_platform_binary() { # <каталог установки> -> относительный путь первого рабочего бинаря
  local dir="$1" rel
  while IFS= read -r rel; do
    if ! { [ -f "$dir/$rel" ] && [ -x "$dir/$rel" ]; }; then continue; fi
    if version_ok "$dir/$rel"; then printf '%s' "$rel"; return 0; fi
  done < <(platform_candidates)
  return 1
}

cache_valid() { # маркер пишется только после проверки бинаря и версии
  local rel
  [ -f "$INSTALL/.subteams-bin" ] || return 1
  rel=$(cat -- "$INSTALL/.subteams-bin" 2>/dev/null) || return 1
  [ -n "$rel" ] && [ -x "$INSTALL/$rel" ] || return 1
  AB_BIN="$INSTALL/$rel"
  AB_SKILLS="$INSTALL/node_modules/agent-browser/skill-data"
}

# --- блокировка mkdir (flock нет в macOS) ------------------------------------
lock_stale() {
  local pid="" ts="" now
  if [ -f "$LOCK/owner" ]; then
    read -r pid ts < "$LOCK/owner" 2>/dev/null || true
    case "$pid" in ''|*[!0-9]*) return 0 ;; esac
    kill -0 "$pid" 2>/dev/null || return 0
    case "$ts" in ''|*[!0-9]*) return 0 ;; esac
    now=$(date +%s)
    [ $((now - ts)) -gt "$LOCK_STALE_AGE" ]
    return
  fi
  # каталог есть, владельца ещё нет: протухший, только если старый
  [ -n "$(find "$LOCK" -maxdepth 0 -mmin +3 2>/dev/null)" ]
}

acquire_lock() {
  local waited=0 aside
  while ! mkdir -- "$LOCK" 2>/dev/null; do
    [ -d "$LOCK" ] || die 127 "не удалось создать блокировку $LOCK"
    if lock_stale; then
      aside="$LOCK.stale.$$"
      # переименование атомарно: из двух ожидающих протухшую забирает один
      mv -- "$LOCK" "$aside" 2>/dev/null && rm -rf -- "$aside"
      continue
    fi
    [ "$waited" -ge "$LOCK_WAIT" ] && die 127 "чужая установка agent-browser идёт дольше ${LOCK_WAIT} с (блокировка $LOCK)"
    sleep 1; waited=$((waited + 1))
  done
  LOCK_HELD=1
  printf '%s %s\n' "$$" "$(date +%s)" > "$LOCK/owner"
}

release_lock() { [ "$LOCK_HELD" = 1 ] && rm -rf -- "$LOCK"; LOCK_HELD=0; }

# --- автоустановка ----------------------------------------------------------
install_fail() {
  [ -n "$TMP_INSTALL" ] && rm -rf -- "$TMP_INSTALL"
  TMP_INSTALL=""
  release_lock
  die 127 "установка agent-browser $AB_VERSION не удалась: $*"
}

auto_install() {
  local log pid rc waited rel
  command -v npm >/dev/null 2>&1 || die 127 "agent-browser $AB_VERSION не найден, а для автоустановки нужен npm (Node.js)"
  command -v node >/dev/null 2>&1 || die 127 "agent-browser $AB_VERSION не найден, а для автоустановки нужен Node.js"
  if ! { [ -f "$DEPS/package.json" ] && [ -f "$DEPS/package-lock.json" ]; }; then
    die 127 "нет зафиксированного дерева зависимостей: $DEPS"
  fi
  mkdir -p -- "$AB_DIR" || die 127 "не удалось создать каталог кэша $AB_DIR"

  acquire_lock
  if cache_valid; then release_lock; return 0; fi   # поставил параллельный запуск
  if [ -e "$INSTALL" ]; then                         # битая установка без маркера
    mv -- "$INSTALL" "$AB_DIR/.broken.$$" 2>/dev/null && rm -rf -- "$AB_DIR/.broken.$$"
    [ -e "$INSTALL" ] && install_fail "не удалось убрать битую установку $INSTALL"
  fi

  # хвосты прерванных установок (обёртку убили посреди npm ci); активная установка — только у владельца блокировки
  find "$AB_DIR" -maxdepth 1 -type d -name '.install-*' -mmin +5 -exec rm -rf {} + 2>/dev/null
  printf 'subteams: устанавливаю agent-browser %s в %s (один раз)\n' "$AB_VERSION" "$INSTALL" >&2
  TMP_INSTALL=$(mktemp -d "$AB_DIR/.install-XXXXXX") || install_fail "не удалось создать временный каталог"
  cp -- "$DEPS/package.json" "$DEPS/package-lock.json" "$TMP_INSTALL/" || install_fail "не удалось скопировать lock-файл"
  log="$AB_DIR/install.log"

  (cd -- "$TMP_INSTALL" && exec npm ci --ignore-scripts --no-fund --no-audit) >"$log" 2>&1 &
  pid=$!
  waited=0
  while kill -0 "$pid" 2>/dev/null; do
    if [ "$waited" -ge "$INSTALL_TIMEOUT" ]; then
      pkill -TERM -P "$pid" 2>/dev/null; kill -TERM "$pid" 2>/dev/null
      sleep 2
      pkill -KILL -P "$pid" 2>/dev/null; kill -KILL "$pid" 2>/dev/null
      wait "$pid" 2>/dev/null
      install_fail "npm ci не уложился в ${INSTALL_TIMEOUT} с; лог: $log"
    fi
    sleep 1; waited=$((waited + 1))
  done
  wait "$pid"; rc=$?
  [ "$rc" -eq 0 ] || install_fail "npm ci завершился с кодом $rc; лог: $log"

  rel=$(pick_platform_binary "$TMP_INSTALL") \
    || install_fail "платформенный бинарь для $(uname -s)/$(uname -m) не найден или его версия не $AB_VERSION; лог: $log"
  printf '%s\n' "$rel" > "$TMP_INSTALL/.subteams-bin" || install_fail "не удалось записать маркер установки"

  # rename(2): атомарно и отказывает, если цель уже есть (у mv такой гарантии нет)
  if ! node -e 'require("fs").renameSync(process.argv[1], process.argv[2])' "$TMP_INSTALL" "$INSTALL" 2>/dev/null; then
    cache_valid && { rm -rf -- "$TMP_INSTALL"; TMP_INSTALL=""; release_lock; return 0; }
    install_fail "не удалось переместить установку в $INSTALL"
  fi
  TMP_INSTALL=""
  release_lock
  cache_valid || die 127 "установка в $INSTALL не прошла проверку"
}

resolve_agent_browser() {
  local sys
  if [ -n "${CLAUDE_SUBTEAMS_AGENT_BROWSER:-}" ]; then
    if ! { [ -f "$CLAUDE_SUBTEAMS_AGENT_BROWSER" ] && [ -x "$CLAUDE_SUBTEAMS_AGENT_BROWSER" ]; }; then
      die 127 "CLAUDE_SUBTEAMS_AGENT_BROWSER указывает не на исполняемый файл"
    fi
    AB_BIN="$CLAUDE_SUBTEAMS_AGENT_BROWSER"; return 0
  fi
  cache_valid && return 0
  if sys=$(command -v agent-browser 2>/dev/null) && [ -n "$sys" ] && version_ok "$sys"; then
    AB_BIN="$sys"; return 0
  fi
  [ "${CLAUDE_SUBTEAMS_NO_AUTO_INSTALL:-}" = 1 ] \
    && die 127 "agent-browser $AB_VERSION не найден, автоустановка выключена (CLAUDE_SUBTEAMS_NO_AUTO_INSTALL=1). Осмотр интерфейса не выполнен"
  auto_install
}

# --- браузер ----------------------------------------------------------------
have_browser() {
  local n a
  if [ -n "${AGENT_BROWSER_EXECUTABLE_PATH:-}" ] && [ -x "$AGENT_BROWSER_EXECUTABLE_PATH" ]; then return 0; fi
  for n in google-chrome google-chrome-stable chromium chromium-browser; do
    command -v "$n" >/dev/null 2>&1 && return 0
  done
  if [ "$(uname -s)" = Darwin ]; then
    for a in "/Applications/Google Chrome.app" "/Applications/Chromium.app" \
             "$HOME/Applications/Google Chrome.app" "$HOME/Applications/Chromium.app"; do
      [ -d "$a" ] && return 0
    done
  fi
  # Chrome for Testing от `subteams-browser setup` (agent-browser install): ~/.agent-browser/browsers
  [ -n "$(ls -A "$HOME/.agent-browser/browsers" 2>/dev/null)" ]
}

# --- квитанция shot (§5.3) --------------------------------------------------
sha1_of() { # stdin -> hex
  if command -v sha1sum >/dev/null 2>&1; then sha1sum | cut -d' ' -f1
  elif command -v shasum >/dev/null 2>&1; then shasum -a 1 | cut -d' ' -f1
  elif command -v openssl >/dev/null 2>&1; then openssl sha1 | sed 's/^.*= *//'
  else return 1; fi
}

json_str() { # экранирование строки для JSON; управляющие символы кроме \n\t\r — отказ
  local s="$1"
  s=${s//\\/\\\\}; s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/\\r}
  case "$s" in *[[:cntrl:]]*) return 1 ;; esac
  printf '"%s"' "$s"
}

write_shot_receipt() { # <абсолютный путь> <сессия>; вне git-репозитория — молча ничего
  local file="$1" session="$2" gcd canon id dir size ts tmp jpath jsess top jroot
  command -v git >/dev/null 2>&1 || return 0
  gcd=$(git rev-parse --git-common-dir 2>/dev/null) || return 0
  [ -n "$gcd" ] || return 0
  canon=$(cd -P -- "$gcd" 2>/dev/null && pwd) || return 0
  id=$(printf '%s' "$canon" | sha1_of) || return 0
  [ -n "$id" ] || return 0
  dir="$CACHE_BASE/receipts/$id"
  (umask 077; mkdir -p -- "$dir") 2>/dev/null || return 0
  size=$(wc -c < "$file" | tr -d ' ') || return 0
  ts=$(date +%s)
  jpath=$(json_str "$file") || return 0
  jsess=$(json_str "$session") || return 0
  # root = рабочее дерево, где снят скриншот (worktree): по нему subagent-rails выбирает снимок
  top=$(git rev-parse --show-toplevel 2>/dev/null) && jroot=$(json_str "$top") || jroot=null
  tmp="$dir/.tmp-shot-$$-$RANDOM"
  printf '{"type":"shot","kind":"shot","path":%s,"size":%s,"session":%s,"ts":%s,"root":%s}\n' "$jpath" "$size" "$jsess" "$ts" "$jroot" > "$tmp" 2>/dev/null \
    && mv -f -- "$tmp" "$dir/shot-$ts-$$-$RANDOM.json" 2>/dev/null
  rm -f -- "$tmp" 2>/dev/null
  find "$dir" -maxdepth 1 -type f -name '*.json' -mtime +14 -exec rm -f {} + 2>/dev/null
  return 0
}

abs_path() { # <путь> -> абсолютный, каталог канонизирован
  local d b
  d=$(cd -P -- "$(dirname -- "$1")" 2>/dev/null && pwd) || return 1
  b=$(basename -- "$1")
  printf '%s/%s' "$d" "$b"
}

# --- разбор аргументов ------------------------------------------------------
first="${1:-}"
if [ "$first" = setup ]; then
  shift
  resolve_agent_browser
  [ -n "$AB_SKILLS" ] && [ -z "${AGENT_BROWSER_SKILLS_DIR:-}" ] && export AGENT_BROWSER_SKILLS_DIR="$AB_SKILLS"
  exec "$AB_BIN" install "$@"
fi

SESSION=""; CMD=""; CMD_IDX=-1
args=("$@")
i=0
while [ "$i" -lt "${#args[@]}" ]; do
  a="${args[$i]}"
  if [ "$a" = --session ]; then
    SESSION="${args[$((i + 1))]:-}"
    i=$((i + 2)); continue
  fi
  if [ -z "$CMD" ] && [ "${a#-}" = "$a" ]; then CMD="$a"; CMD_IDX=$i; fi
  i=$((i + 1))
done

# Запреты (R3 и «только своя сессия»): Chrome — только через setup, версия закреплена плагином
case "$CMD" in
  install) die 2 "install через обёртку запрещён: используй \`subteams-browser setup\`" ;;
  upgrade) die 2 "upgrade запрещён: версия agent-browser $AB_VERSION закреплена плагином и меняется только его релизом" ;;
esac
for a in "$@"; do
  case "$a" in
    --all) [ "$CMD" = close ] && die 2 "close --all запрещён: закрывай только свою сессию (subteams-browser --session <имя> close)" ;;
    --executable-path|--executable-path=*)
      die 2 "--executable-path запрещён: браузер задаётся пользователем через AGENT_BROWSER_EXECUTABLE_PATH; Chromium Playwright не использовать — требует --no-sandbox" ;;
  esac
done

# Без сессии — только справка, версия и встроенные скиллы agent-browser
exempt=0
if [ "$#" -eq 0 ]; then exempt=1; else
  case "$first" in --version|-V|--help|-h|help|skills) exempt=1 ;; esac
  case "$CMD" in skills) [ "$CMD_IDX" -le 2 ] && exempt=1 ;; esac
fi

if [ "$exempt" = 0 ]; then
  case "$SESSION" in
    ''|-*) die 2 "нужна своя сессия: subteams-browser --session <имя> <команда> … (общая сессия по умолчанию не используется)" ;;
  esac
  need_browser=1
  for a in "$@"; do
    case "$a" in --cdp|--auto-connect) need_browser=0 ;; esac
  done
  if [ "$need_browser" = 1 ] && ! have_browser; then
    die 127 "браузер не найден: поставь Chrome или \`subteams-browser setup\` (~150 МБ). Осмотр интерфейса не выполнен"
  fi
fi

resolve_agent_browser
[ -n "$AB_SKILLS" ] && [ -z "${AGENT_BROWSER_SKILLS_DIR:-}" ] && export AGENT_BROWSER_SKILLS_DIR="$AB_SKILLS"

if [ "$CMD" != screenshot ]; then
  exec "$AB_BIN" "$@"
fi

# screenshot: запуск дочерним процессом, чтобы после успеха записать квитанцию
stamp=$(mktemp "${TMPDIR:-/tmp}/subteams-shot-XXXXXX") || stamp=""
"$AB_BIN" "$@"
rc=$?
if [ "$rc" -eq 0 ] && [ -n "$stamp" ]; then
  # путь — последний позиционный аргумент после screenshot, который стал свежим непустым файлом
  shot=""
  j=$((CMD_IDX + 1))
  while [ "$j" -lt "${#args[@]}" ]; do
    a="${args[$j]}"
    if [ "${a#-}" = "$a" ] && [ -f "$a" ] && [ -s "$a" ] && ! [ "$stamp" -nt "$a" ]; then shot="$a"; fi
    j=$((j + 1))
  done
  if [ -n "$shot" ] && shot_abs=$(abs_path "$shot"); then
    write_shot_receipt "$shot_abs" "$SESSION"
  elif git rev-parse --git-dir >/dev/null 2>&1; then
    # относительный путь agent-browser считает от каталога, где сессия была открыта, а не от текущего
    say "скриншот снят, но квитанция shot не записана: передай абсолютный путь к файлу"
  fi
fi
[ -n "$stamp" ] && rm -f -- "$stamp"
exit "$rc"
